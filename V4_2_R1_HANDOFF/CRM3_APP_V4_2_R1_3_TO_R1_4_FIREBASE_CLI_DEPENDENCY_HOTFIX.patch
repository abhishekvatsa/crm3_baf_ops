+  $report = [ordered]@{
+    expected = [ordered]@{
+      firebaseTools = $expected.firebaseTools
+      honoNodeServer = $expected.honoNodeServer
+      fastUri = $expected.fastUri
+    }
+    declared = [ordered]@{
