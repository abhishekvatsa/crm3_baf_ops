+  if ($py) { return [ordered]@{exe = $py.Source; prefix = @('-3')} }
+  $script:failureStatus = 'HOLD_REQUIRED_TOOL_MISSING'
+  throw 'Python 3 is required.'
+}
+
+function Assert-ExactHash {
+  param([string]$Path, [string]$ExpectedHash, [string]$Label)
