+  firebaseOptionsSha256 = '07912823FCC37500C785BE26741B3930087D7A47F02F5E2268F7C7FC1A6031DE'
+  canonicalGoogleServicesSha256 = 'DBD4450D064E6FE68D2F809A8A81B1FE5AC6E96E390F8F0B1762938D0EF5FE6D'
