+  if ($actual -ne $ExpectedHash) {
+    $script:failureStatus = 'HOLD_FIREBASE_CUSTODY_MISMATCH'
+    throw "$Label SHA-256 mismatch. Expected $ExpectedHash; got $actual"
+  }
+  return $actual
+}
