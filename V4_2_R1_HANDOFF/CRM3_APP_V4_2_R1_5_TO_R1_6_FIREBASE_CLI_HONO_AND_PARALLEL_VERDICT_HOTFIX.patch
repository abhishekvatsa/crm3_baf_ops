+function Invoke-RecordedHoldStep {
+  param(
+    [Parameter(Mandatory)][string]$Name,
+    [Parameter(Mandatory)][scriptblock]$Action,
+    [Parameter(Mandatory)][string]$HoldStatus,
+    [string]$WorkingDirectory = $workspace
