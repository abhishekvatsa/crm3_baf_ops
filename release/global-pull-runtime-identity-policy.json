{
  "schemaVersion": 2,
  "policyId": "GLOBAL-PULL-RUNTIME-IDENTITY-POLICY-V2",
  "declarationStatus": "SOURCE_IMPLEMENTED_PENDING_IAM_AND_DEPLOYMENT",
  "productionProjectId": "crm3-baf-ops-b8638",
  "targetProjectBinding": {
    "builtInParameter": "PROJECT_ID",
    "serviceAccountDomain": "iam.gserviceaccount.com",
    "sameProjectRequired": true,
    "crossProjectResolutionAllowed": false
  },
  "functionBindings": {
    "beginGlobalPullRun": {
      "runtimeServiceAccountId": "crm3-global-pull-reader",
      "runtimeServiceAccountTemplate": "crm3-global-pull-reader@${PROJECT_ID}.iam.gserviceaccount.com",
      "productionResolvedRuntimeServiceAccount": "crm3-global-pull-reader@crm3-baf-ops-b8638.iam.gserviceaccount.com",
      "requiredProjectRoles": [
        "roles/datastore.viewer",
        "roles/logging.logWriter"
      ],
      "firestoreAccess": "READ_ONLY"
    },
    "stampGlobalPullServerClock": {
      "runtimeServiceAccountId": "crm3-global-pull-writer",
      "runtimeServiceAccountTemplate": "crm3-global-pull-writer@${PROJECT_ID}.iam.gserviceaccount.com",
      "productionResolvedRuntimeServiceAccount": "crm3-global-pull-writer@crm3-baf-ops-b8638.iam.gserviceaccount.com",
      "requiredProjectRoles": [
        "roles/datastore.user",
        "roles/eventarc.eventReceiver",
        "roles/run.invoker",
        "roles/logging.logWriter"
      ],
      "firestoreAccess": "READ_WRITE_PROTOCOL_COLLECTIONS_ENFORCED_BY_SOURCE"
    }
  },
  "forbiddenProjectRoles": [
    "roles/owner",
    "roles/editor",
    "roles/iam.securityAdmin",
    "roles/iam.serviceAccountAdmin",
    "roles/iam.serviceAccountTokenCreator"
  ],
  "deploymentScope": [
    "beginGlobalPullRun",
    "stampGlobalPullServerClock"
  ],
  "existingFunctionFleetMutationAuthorized": false,
  "defaultComputeRoleMutationAuthorized": false,
  "crossProjectGrantAuthorized": false,
  "deploymentTargetRequirements": [
    "Resolve PROJECT_ID from the Firebase deployment target without an operator-supplied override.",
    "Create both runtime service accounts in the same target project before deployment.",
    "Read back each deployed function and reject a runtime identity outside the target project.",
    "Keep production and staging IAM grants isolated."
  ],
  "nonClaims": [
    "This source policy does not create service accounts or mutate IAM.",
    "This source policy does not deploy Functions, Rules or indexes.",
    "This source policy does not close S-01, H2-IAM or LR-03.",
    "This source policy does not authorize runtime contract activation, device validation or pilot handout."
  ]
}
