# Parameter values for the local development emulator project.
#
# firebase-functions resolves CRM3_MUTATING_CALLABLE_ENFORCE_APP_CHECK at load
# time because callableSecurityConfig.ts reads it with .value() during
# deployment analysis. Without a value supplied here the Functions emulator
# stops and prompts for it interactively, which never completes in a launcher
# or in CI, so no function registers and every callable returns NOT_FOUND.
#
# false is the source default in functions/src/callableSecurityConfig.ts, so
# this changes no behaviour. It only lets the emulator start unattended.
CRM3_MUTATING_CALLABLE_ENFORCE_APP_CHECK=false
