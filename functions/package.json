{
  "name": "crm3-baf-ops-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "audit:callable-inventory": "node tools/audit_callable_inventory.mjs",
    "audit:emitted-output": "node tools/emitted_output_custody.mjs audit",
    "build": "npm run clean && tsc --pretty false && npm run audit:emitted-output && npm run audit:callable-inventory",
    "clean": "node tools/emitted_output_custody.mjs clean",
    "test": "npm run build && npm run test:emitted-output-custody && npm run test:callable-inventory && jest --runInBand",
    "test:callable-inventory": "node --test tools/audit_callable_inventory.test.mjs",
    "test:emitted-output-custody": "node --test tools/emitted_output_custody.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test:emulator:authority": "npm run build && jest --runInBand --detectOpenHandles test/userAuthorityMutation.firestoreEmulator.test.js",
    "test:emulator:closure": "npm run build && jest --runInBand --detectOpenHandles test/plannedJobClosure.firestoreEmulator.test.js",
    "test:emulator:workflow": "npm run build && jest --runInBand --detectOpenHandles test/maintenanceWorkflow.firestoreEmulator.test.js test/workflowAuthorityReplayAdjudication.firestoreEmulator.test.js",
    "test:emulator:abnormality": "npm run build && jest --runInBand --detectOpenHandles test/chargeAbnormalityMutation.firestoreEmulator.test.js",
    "test:emulator:global-pull": "npm run build && jest --runInBand --detectOpenHandles test/globalPullServerClockGovernance.firestoreEmulator.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulator:governed": "npm run build && jest --runInBand --detectOpenHandles test/plannedJobClosure.firestoreEmulator.test.js test/runtimeJobModulePopulation.firestoreEmulator.test.js test/publishedTemplateAssignment.firestoreEmulator.test.js test/maintenanceWorkflow.firestoreEmulator.test.js test/workflowAuthorityReplayAdjudication.firestoreEmulator.test.js test/userAuthorityMutation.firestoreEmulator.test.js test/chargeAbnormalityMutation.firestoreEmulator.test.js test/callableAbuseControl.firestoreEmulator.test.js test/globalPullServerClockGovernance.firestoreEmulator.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "brace-expansion": "file:../tooling/brace-expansion-compat",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "6.15.2",
    "uuid": "11.1.1",
    "@grpc/grpc-js": "1.14.4",
    "brace-expansion": "$brace-expansion"
  }
}
