{
  "name": "crm3-baf-ops-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && jest --runInBand",
    "test:emulator:closure": "npm run build && jest --runInBand --detectOpenHandles test/plannedJobClosure.firestoreEmulator.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulator:governed": "npm run build && jest --runInBand --detectOpenHandles test/plannedJobClosure.firestoreEmulator.test.js test/runtimeJobModulePopulation.firestoreEmulator.test.js test/publishedTemplateAssignment.firestoreEmulator.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "6.15.2",
    "uuid": "11.1.1",
    "@grpc/grpc-js": "1.14.4"
  }
}
