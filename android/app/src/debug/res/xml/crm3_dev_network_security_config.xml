<?xml version="1.0" encoding="utf-8"?>
<!--
  Development only. This file lives under src/debug, so it is never part of a
  release build and production keeps Android's default cleartext prohibition.

  The Firebase emulator suite serves plain HTTP. The Firebase SDKs rewrite
  127.0.0.1 to 10.0.2.2 when they detect an Android emulator, so both loopback
  forms are listed. Nothing else is permitted: this is a per-domain exception,
  not a base-config that would allow cleartext to any host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
