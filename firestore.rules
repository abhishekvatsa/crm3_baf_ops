    function maintenanceWorkflowFieldsUnchanged() {
      return request.resource.data.get('workflowDeferred', false) == resource.data.get('workflowDeferred', false)
        && request.resource.data.get('workflowQueueState', 'independent') == resource.data.get('workflowQueueState', 'independent')
        && request.resource.data.get('workflowAggregateId', null) == resource.data.get('workflowAggregateId', null)
        && request.resource.data.get('workflowComplianceId', null) == resource.data.get('workflowComplianceId', null)
        && request.resource.data.get('workflowOriginLaneKey', null) == resource.data.get('workflowOriginLaneKey', null)
        && request.resource.data.get('workflowTargetLaneKey', null) == resource.data.get('workflowTargetLaneKey', null)
        && request.resource.data.get('workflowConditionTypeKey', null) == resource.data.get('workflowConditionTypeKey', null)
        && request.resource.data.get('workflowConditionRef', null) == resource.data.get('workflowConditionRef', null)
        && request.resource.data.get('workflowDeferredAt', null) == resource.data.get('workflowDeferredAt', null)
        && request.resource.data.get('workflowDeferredByUid', null) == resource.data.get('workflowDeferredByUid', null)
        && request.resource.data.get('workflowDeferredByName', null) == resource.data.get('workflowDeferredByName', null)
        && request.resource.data.get('workflowReactivatedAt', null) == resource.data.get('workflowReactivatedAt', null)
        && request.resource.data.get('workflowReactivatedByUid', null) == resource.data.get('workflowReactivatedByUid', null)
        && request.resource.data.get('workflowReactivatedByName', null) == resource.data.get('workflowReactivatedByName', null)
        && request.resource.data.get('workflowReleasedAt', null) == resource.data.get('workflowReleasedAt', null)
        && request.resource.data.get('workflowReleasedByUid', null) == resource.data.get('workflowReleasedByUid', null)
        && request.resource.data.get('workflowReleasedByName', null) == resource.data.get('workflowReleasedByName', null)
        && request.resource.data.get('workflowCorrectionReason', null) == resource.data.get('workflowCorrectionReason', null)
        && request.resource.data.get('workflowUpdatedAt', null) == resource.data.get('workflowUpdatedAt', null);
    }

    function maintenanceWorkflowAllowsClientLifecycle() {
      return resource.data.get('workflowDeferred', false) == false
        && request.resource.data.get('workflowDeferred', false) == false
        && maintenanceWorkflowFieldsUnchanged();
    }

    function validMaintenanceCreate(docId) {
      return isApprovedUser()
        && !request.resource.data.keys().hasAny(maintenanceWorkflowFields())
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'version',
          'assetType',
          'assetNumber',
          'maintenanceType',
          'description',
          'routedTo',
          'status',
          'isResolved',
          'isCritical',
          'loggedByUid',
          'createdAt',
          'updatedAt',
          'isDeleted'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('assetType', null) is string
        && request.resource.data.get('assetNumber', -1) is int
        && request.resource.data.get('maintenanceType', null) is string
        && request.resource.data.get('description', null) is string
        && request.resource.data.get('routedTo', null) is string
        && request.resource.data.get('status', null) is string
        && request.resource.data.get('isResolved', null) == false
        && request.resource.data.get('isCritical', null) is bool
        && request.resource.data.get('loggedByUid', null) == request.auth.uid
        && request.resource.data.get('createdAt', null) is string
        && request.resource.data.get('updatedAt', null) is string
        && request.resource.data.get('isDeleted', null) == false;
    }

    function maintenanceCloseChangedFieldsOnly(affected) {
      return affected.hasOnly([
        'isResolved',
        'status',
        'closedByUid',
        'closedByName',
        'closedAt',
        'resolvedByUid',
        'resolvedByName',
        'resolvedAt',
        'resolutionNote',
        'resolutionNotes',
        'resolutionDetails',
        'endDate',
        'remarks',
        'downtimeHours',
        'teamsInvolved',
        'actionsJson',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ]);
    }

    function maintenanceResolutionFieldsFrozenOnReopen() {
      return request.resource.data.get('closedByUid', null) == resource.data.get('closedByUid', null)
        && request.resource.data.get('closedByName', null) == resource.data.get('closedByName', null)
        && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
        && request.resource.data.get('resolvedByUid', null) == resource.data.get('resolvedByUid', null)
        && request.resource.data.get('resolvedByName', null) == resource.data.get('resolvedByName', null)
        && request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null)
        && request.resource.data.get('resolutionNote', null) == resource.data.get('resolutionNote', null)
        && request.resource.data.get('resolutionNotes', null) == resource.data.get('resolutionNotes', null)
        && request.resource.data.get('resolutionDetails', null) == resource.data.get('resolutionDetails', null);
