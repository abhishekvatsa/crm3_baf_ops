    function maintenanceWorkflowFieldsUnchanged() {
      return request.resource.data.get('workflowDeferred', false) == resource.data.get('workflowDeferred', false)
        && request.resource.data.get('workflowQueueState', 'independent') == resource.data.get('workflowQueueState', 'independent')
        && request.resource.data.get('workflowAggregateId', null) == resource.data.get('workflowAggregateId', null)
        && request.resource.data.get('workflowComplianceId', null) == resource.data.get('workflowComplianceId', null)
        && request.resource.data.get('workflowOriginLaneKey', null) == resource.data.get('workflowOriginLaneKey', null)
        && request.resource.data.get('workflowTargetLaneKey', null) == resource.data.get('workflowTargetLaneKey', null)
        && request.resource.data.get('workflowConditionTypeKey', null) == resource.data.get('workflowConditionTypeKey', null)
        && request.resource.data.get('workflowConditionRef', null) == resource.data.get('workflowConditionRef', null)
        && request.resource.data.get('workflowDeferredAt', null) == resource.data.get('workflowDeferredAt', null)
        && request.resource.data.get('workflowDeferredByUid', null) == resource.data.get('workflowDeferredByUid', null)
        && request.resource.data.get('workflowDeferredByName', null) == resource.data.get('workflowDeferredByName', null)
        && request.resource.data.get('workflowReactivatedAt', null) == resource.data.get('workflowReactivatedAt', null)
        && request.resource.data.get('workflowReactivatedByUid', null) == resource.data.get('workflowReactivatedByUid', null)
        && request.resource.data.get('workflowReactivatedByName', null) == resource.data.get('workflowReactivatedByName', null)
        && request.resource.data.get('workflowReleasedAt', null) == resource.data.get('workflowReleasedAt', null)
        && request.resource.data.get('workflowReleasedByUid', null) == resource.data.get('workflowReleasedByUid', null)
        && request.resource.data.get('workflowReleasedByName', null) == resource.data.get('workflowReleasedByName', null)
        && request.resource.data.get('workflowCorrectionReason', null) == resource.data.get('workflowCorrectionReason', null)
        && request.resource.data.get('workflowUpdatedAt', null) == resource.data.get('workflowUpdatedAt', null);
    }

    function maintenanceWorkflowAllowsClientLifecycle() {
      return resource.data.get('workflowDeferred', false) == false
        && request.resource.data.get('workflowDeferred', false) == false
        && maintenanceWorkflowFieldsUnchanged();
    }

    function validMaintenanceQualityIntent() {
      let qualityFields = [
        'qualityIntentSchemaVersion',
        'qualityImpactAssessment',
        'qualityWarningReason'
      ];
      let hasAny = request.resource.data.keys().hasAny(qualityFields);
      let hasAll = request.resource.data.keys().hasAll(qualityFields);
      let assessment = request.resource.data.get(
        'qualityImpactAssessment',
        null
      );
      let warningReason = request.resource.data.get(
        'qualityWarningReason',
        null
      );
      let chargeNo = request.resource.data.get('chargeNoAtEvent', null);
      return !hasAny
        || (hasAll
          && request.resource.data.get('qualityIntentSchemaVersion', -1) == 1
          && (assessment == 'notSuspected' || assessment == 'suspected')
          && (assessment == 'notSuspected'
            ? warningReason == null
            : (warningReason is string
              && warningReason.size() >= 8
              && warningReason.size() <= 1000
              && isFiveDigitChargeNumber(chargeNo))));
    }

    function validBurnerResolutionEvidenceEntry(evidence, key) {
      let entry = evidence.get(key, {});
      let codes = entry.get('actionCodes', []);
      let outcome = entry.get('outcome', null);
      let microampReading = entry.get('microampReading', null);
      return entry is map
        && entry.keys().hasAll(['outcome', 'actionCodes'])
        && entry.keys().hasOnly([
          'outcome',
          'actionCodes',
          'microampReading'
        ])
        && codes is list
        && codes.size() >= 1
        && codes.size() <= 14
        && codes.toSet().size() == codes.size()
        && codes.hasOnly([
          'feedbackReset',
          'airLineCleaning',
          'uvDetectorCleaning',
          'poking',
          'flameAdjustment',
          'igniterRodHolderCleaning',
          'burnerControllerReset',
          'burnerControllerPowerOn',
          'safetyShutoffValveRelayWork',
          'relay6A6BWork',
          'igniterRodReplacement',
          'uvDetectorReplacement',
          'safetyShutoffValveSolenoidWork',
          'other'
        ])
        && [
          'returnedToService',
          'remainsLockedOut',
          'isolatedForFollowUp'
        ].hasAny([outcome])
        && (!entry.keys().hasAny(['microampReading'])
          || (microampReading is number
            && microampReading >= 0
            && microampReading <= 1000000))
        && (outcome != 'returnedToService'
          || codes.hasAny([
            'airLineCleaning',
            'uvDetectorCleaning',
            'poking',
            'flameAdjustment',
            'igniterRodHolderCleaning',
            'safetyShutoffValveRelayWork',
            'relay6A6BWork',
            'igniterRodReplacement',
            'uvDetectorReplacement',
            'safetyShutoffValveSolenoidWork',
            'other'
          ]));
    }

    function validBurnerResolutionEvidence(positions, evidence) {
      return evidence is map
        && evidence.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7', '8'])
        && evidence.size() == positions.size()
        && (positions.hasAny([1])
          ? validBurnerResolutionEvidenceEntry(evidence, '1')
          : !evidence.keys().hasAny(['1']))
        && (positions.hasAny([2])
          ? validBurnerResolutionEvidenceEntry(evidence, '2')
          : !evidence.keys().hasAny(['2']))
        && (positions.hasAny([3])
          ? validBurnerResolutionEvidenceEntry(evidence, '3')
          : !evidence.keys().hasAny(['3']))
        && (positions.hasAny([4])
          ? validBurnerResolutionEvidenceEntry(evidence, '4')
          : !evidence.keys().hasAny(['4']))
        && (positions.hasAny([5])
          ? validBurnerResolutionEvidenceEntry(evidence, '5')
          : !evidence.keys().hasAny(['5']))
        && (positions.hasAny([6])
          ? validBurnerResolutionEvidenceEntry(evidence, '6')
          : !evidence.keys().hasAny(['6']))
        && (positions.hasAny([7])
          ? validBurnerResolutionEvidenceEntry(evidence, '7')
          : !evidence.keys().hasAny(['7']))
        && (positions.hasAny([8])
          ? validBurnerResolutionEvidenceEntry(evidence, '8')
          : !evidence.keys().hasAny(['8']));
    }

    function validBurnerClosureEvidenceWrite(docId) {
      let sourcePath =
        /databases/$(database)/documents/maintenance_records/$(docId);
      let source = getAfter(sourcePath).data;
      let evidence = request.resource.data.get(
        'burnerResolutionEvidence',
        {}
      );
      return isApprovedUser()
        && existsAfter(sourcePath)
        && request.resource.data.keys().hasOnly([
          'firestoreId',
          'sourceMaintenanceId',
          'sourceVersion',
          'closedByUid',
          'burnerResolutionEvidence',
          'updatedAt'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('sourceMaintenanceId', null) == docId
        && request.resource.data.get('sourceVersion', -1) is int
        && request.resource.data.get('sourceVersion', -1) ==
          source.get('version', -2)
        && request.resource.data.get('closedByUid', null) == request.auth.uid
        && request.resource.data.get('closedByUid', null) ==
          source.get('closedByUid', null)
        && request.resource.data.get('updatedAt', null) ==
          source.get('updatedAt', null)
        && source.get('classification', null) == 'furnaceBurnerLockout'
        && source.get('isResolved', false) == true
        && evidence == source.get('burnerResolutionEvidence', null)
        && validBurnerResolutionEvidence(
          source.get('burnerPositions', []),
          evidence
        );
    }

    function requiredBurnerClosureEvidenceExists(docId) {
      let evidencePath =
        /databases/$(database)/documents/maintenance_burner_closures/$(docId);
      let evidence = getAfter(evidencePath).data;
      return resource.data.get('classification', null) !=
          'furnaceBurnerLockout'
        || (existsAfter(evidencePath)
          && evidence.get('sourceMaintenanceId', null) == docId
          && evidence.get('sourceVersion', -1) ==
            request.resource.data.get('version', -2)
          && evidence.get('closedByUid', null) == request.auth.uid
          && evidence.get('burnerResolutionEvidence', null) ==
            request.resource.data.get('burnerResolutionEvidence', null));
    }

    function validBurnerRedHotDirectiveProjection(
      directive,
      source,
      directiveId,
      sourceId
    ) {
      return source.get('classification', null) == 'furnaceBurnerLockout'
        && source.get('burnerRedHotPositions', []).size() > 0
        && directive.get('firestoreId', null) == directiveId
        && directiveId == 'burner_red_hot_' + sourceId
        && directive.get('linkedMaintenanceFirestoreId', null) == sourceId
        && directive.get('title', null) is string
        && directive.get('description', null) is string
        && directive.get('assetType', null) == 'furnace'
        && directive.get('assetNumber', -1) == source.get('assetNumber', -2)
        && directive.get('component', null) == 'Burner block'
        && directive.get('subsystem', null) == 'Burner system'
        && directive.get('directedTo', null) == 'seniorInstrumentation'
        && directive.get('status', null) == 'open'
        && directive.get('priority', null) == 'critical'
        && directive.get('createdByUid', null) ==
          source.get('loggedByUid', null)
        && directive.get('createdByUid', null) == request.auth.uid
        && directive.get('createdByName', null) ==
          source.get('loggedByName', null)
        && directive.get('issuedByUid', null) ==
          source.get('loggedByUid', null)
        && directive.get('issuedByUid', null) == request.auth.uid
        && directive.get('issuedByName', null) ==
          source.get('loggedByName', null)
        && directive.get('createdAt', null) == source.get('createdAt', null)
        && directive.get('updatedAt', null) == source.get('createdAt', null)
        && directive.get('issuedAt', null) == source.get('createdAt', null)
        && directive.get('isActive', false) == true
        && directive.get('acknowledgedByUid', null) == null
        && directive.get('acknowledgedByName', null) == null
        && directive.get('acknowledgedAt', null) == null
        && directive.get('closedByUid', null) == null
        && directive.get('closedByName', null) == null
        && directive.get('closedAt', null) == null
        && directive.get('closedWithoutAcknowledgement', true) == false
        && directive.get('isDeleted', true) == false
        && directive.get('deletedAt', null) == null
        && directive.get('deletedByUid', null) == null
        && directive.get('deletedByName', null) == null
        && directive.get('deleteReason', null) == null
        && directive.get('version', -1) == 1;
    }

    function maintenanceCloseChangedFieldsOnly(affected) {
      return affected.hasOnly([
        'isResolved',
        'status',
        'closedByUid',
        'closedByName',
        'closedAt',
        'resolvedByUid',
        'resolvedByName',
        'resolvedAt',
        'resolutionNote',
        'resolutionNotes',
        'resolutionDetails',
        'endDate',
        'remarks',
        'downtimeHours',
        'teamsInvolved',
        'actionsJson',
        'burnerAttendedPositions',
        'burnerResolutionEvidence',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ]);
    }

    function maintenanceResolutionFieldsFrozenOnReopen() {
      return request.resource.data.get('closedByUid', null) == resource.data.get('closedByUid', null)
        && request.resource.data.get('closedByName', null) == resource.data.get('closedByName', null)
        && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
        && request.resource.data.get('resolvedByUid', null) == resource.data.get('resolvedByUid', null)
        && request.resource.data.get('resolvedByName', null) == resource.data.get('resolvedByName', null)
        && request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null)
        && request.resource.data.get('resolutionNote', null) == resource.data.get('resolutionNote', null)
        && request.resource.data.get('resolutionNotes', null) == resource.data.get('resolutionNotes', null)
        && request.resource.data.get('resolutionDetails', null) == resource.data.get('resolutionDetails', null);
    }

    function maintenanceReopenChangedFieldsOnly(affected) {
      return affected.hasOnly([
        'isResolved',
        'status',
        'reopenedByUid',
        'reopenedByName',
        'reopenedAt',
        'reopenReason',
        'endDate',
        'closedByUid',
        'closedByName',
        'downtimeHours',
        'teamsInvolved',
        'actionsJson',
        'burnerAttendedPositions',
        'burnerResolutionEvidence',
        'remarks',
        'resolutionHistoryJson',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ]);
    }

    function maintenanceUsesMobileCloseFields() {
      return resource.data.keys().hasAny([
        'endDate',
        'downtimeHours',
        'teamsInvolved',
        'actionsJson',
        'resolutionHistoryJson'
      ]);
    }

    function maintenanceMobileCloseFieldsClearedOnReopen() {
      return maintenanceUsesMobileCloseFields()
        && request.resource.data.get('endDate', null) == null
        && request.resource.data.get('closedByUid', null) == null
        && request.resource.data.get('closedByName', null) == null
        && request.resource.data.get('downtimeHours', null) == null
        && request.resource.data.get('teamsInvolved', []) is list
        && request.resource.data.get('teamsInvolved', []).size() == 0
        && request.resource.data.get('actionsJson', '[]') == '[]'
        && request.resource.data.get('resolutionHistoryJson', '[]') is string;
    }

    function maintenanceLegacyResolutionFieldsFrozenOnReopen(affected) {
      return !maintenanceUsesMobileCloseFields()
        && !affected.hasAny([
          'endDate',
          'closedByUid',
          'closedByName',
          'downtimeHours',
          'teamsInvolved',
          'actionsJson',
          'remarks',
          'resolutionHistoryJson'
        ])
        && maintenanceResolutionFieldsFrozenOnReopen();
    }

    function maintenanceVersionAdvances() {
      return request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function validMaintenanceBurnerCloseState() {
      let special = resource.data.get('classification', null) ==
        'furnaceBurnerLockout';
      let positions = resource.data.get('burnerPositions', []);
      let evidence = request.resource.data.get(
        'burnerResolutionEvidence',
        {}
      );
      return special
        ? (request.resource.data.get('burnerAttendedPositions', []).size() ==
              positions.size()
          && request.resource.data.get('burnerAttendedPositions', [])
            .hasAll(positions)
          && evidence is map
          && evidence.size() == positions.size()
          && requiredBurnerClosureEvidenceExists(
            request.resource.data.get('firestoreId', '')
          ))
        : (!request.resource.data.keys().hasAny([
          'burnerAttendedPositions',
          'burnerResolutionEvidence'
        ]));
    }

    function validMaintenanceBurnerReopenState() {
      return resource.data.get('classification', null) !=
          'furnaceBurnerLockout'
        ? (!request.resource.data.keys().hasAny([
          'burnerAttendedPositions',
          'burnerResolutionEvidence'
        ]))
        : (request.resource.data.get('burnerAttendedPositions', null) == []
          && request.resource.data.get('burnerResolutionEvidence', null) is map
          && request.resource.data.get('burnerResolutionEvidence', {}).size() == 0);
    }

    function maintenanceIsCloseTransition() {
      return resource.data.get('isResolved', false) == false
        && request.resource.data.get('isResolved', false) == true;
    }

    function maintenanceIsReopenTransition() {
      return resource.data.get('isResolved', false) == true
        && request.resource.data.get('isResolved', false) == false;
    }

    function maintenanceSoftDeleteChangedFieldsOnly(affected) {
      return affected.hasOnly([
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'updatedAt',
        'version'
      ]);
    }

    function validMaintenanceCloseUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return maintenanceCloseChangedFieldsOnly(affected)
        && affected.hasAll(['isResolved', 'status', 'closedByUid'])
        ? (maintenanceIsCloseTransition()
          && canCloseMaintenanceTicket()
          && resource.data.get('isDeleted', false) == false
          && request.resource.data.get('isDeleted', false) == false
          && request.resource.data.get('status', null) == 'resolved'
          && request.resource.data.get('closedByUid', null) == request.auth.uid
          && request.resource.data.get('endDate', '') is string
          && request.resource.data.get('teamsInvolved', []) is list
          && request.resource.data.get('actionsJson', '[]') is string
          && (resource.data.get('classification', null) !=
              'furnaceBurnerLockout'
            || request.resource.data.get('actionsJson', '[]') != '[]')
          && validMaintenanceBurnerCloseState()
          && maintenanceWorkflowAllowsClientLifecycle()
          && maintenanceVersionAdvances())
        : false;
    }

    function validMaintenanceReopenUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return maintenanceReopenChangedFieldsOnly(affected)
        && affected.hasAll(['isResolved', 'status'])
        ? (maintenanceIsReopenTransition()
          && canReopenMaintenanceTicket()
          && resource.data.get('isDeleted', false) == false
          && request.resource.data.get('isDeleted', false) == false
          && request.resource.data.get('status', null) == 'open'
          && (maintenanceMobileCloseFieldsClearedOnReopen()
            || maintenanceLegacyResolutionFieldsFrozenOnReopen(affected))
          && validMaintenanceBurnerReopenState()
          && maintenanceWorkflowAllowsClientLifecycle()
          && maintenanceVersionAdvances())
        : false;
    }

    function validMaintenanceSoftDeleteUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return maintenanceSoftDeleteChangedFieldsOnly(affected)
        && affected.hasAll(['isDeleted', 'deletedByUid'])
        ? (isAdmin()
          && resource.data.get('isDeleted', false) == false
          && request.resource.data.get('isDeleted', false) == true
          && request.resource.data.get('deletedByUid', '') == request.auth.uid
          && maintenanceWorkflowAllowsClientLifecycle()
          && maintenanceVersionAdvances())
        : false;
    }

    function validMaintenanceUpdate() {
      let sourceDeleted = resource.data.get('isDeleted', false);
      let targetDeleted = request.resource.data.get('isDeleted', false);
      let sourceResolved = resource.data.get('isResolved', false);
      let targetResolved = request.resource.data.get('isResolved', false);
      return targetTombstoneHasDeletionAuthority()
        && validMaintenanceQualityIntent()
        && (targetDeleted != sourceDeleted
        ? validMaintenanceSoftDeleteUpdate()
        : (targetResolved != sourceResolved
          ? (targetResolved
            ? validMaintenanceCloseUpdate()
            : validMaintenanceReopenUpdate())
          : false));
    }

    // ─────────────────────────────────────────────
    // ⚠️ ABNORMALITY HELPERS
    // ─────────────────────────────────────────────

    function validOptionalAbnormalityTypeText(value, maxLength) {
      return value == null || validNonEmptyString(value, maxLength);
    }

    function validAbnormalityTypeAssetTypes(value) {
      return value is list
        && value.size() <= 5
        && value.hasOnly([
          'base',
          'furnace',
          'forceCooler',
          'innerCover',
          'governedCustom'
        ])
        && value.toSet().size() == value.size();
    }

    function validAbnormalityTypeWrite(docId) {
      let isDeleted = request.resource.data.get('isDeleted', null);
      let deletedAt = request.resource.data.get('deletedAt', null);
      let deletedByUid = request.resource.data.get('deletedByUid', null);
      let deletedByName = request.resource.data.get('deletedByName', null);
      let deleteReason = request.resource.data.get('deleteReason', null);
      let category = request.resource.data.get('category', null);
      let severity = request.resource.data.get('severity', null);
      return request.resource.data.get('firestoreId', null) == docId
        && validNonEmptyString(request.resource.data.get('code', null), 160)
        && validNonEmptyString(request.resource.data.get('title', null), 500)
        && validOptionalAbnormalityTypeText(
          request.resource.data.get('description', null),
          4000
        )
        && (category == 'process'
          || category == 'equipment'
          || category == 'resultQuality'
          || category == 'reannealing'
          || category == 'other')
        && (severity == 'low'
          || severity == 'medium'
          || severity == 'high'
          || severity == 'critical')
        && validAbnormalityTypeAssetTypes(
          request.resource.data.get('applicableAssetTypes', null)
        )
        && request.resource.data.get('suggestsReannealing', null) is bool
        && request.resource.data.get('isActive', null) is bool
        && isDeleted is bool
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && isPersistedTimestamp(request.resource.data.get('createdAt', null))
        && isPersistedTimestamp(request.resource.data.get('updatedAt', null))
        && validNonEmptyString(
          request.resource.data.get('createdByUid', null),
          512
        )
        && validOptionalAbnormalityTypeText(
          request.resource.data.get('createdByName', null),
          500
        )
        && validNonEmptyString(
          request.resource.data.get('lastEditedByUid', null),
          512
        )
        && validOptionalAbnormalityTypeText(
          request.resource.data.get('lastEditedByName', null),
          500
        )
        && validOptionalAbnormalityTypeText(deletedByUid, 512)
        && validOptionalAbnormalityTypeText(deletedByName, 500)
        && validOptionalAbnormalityTypeText(deleteReason, 2000)
        && (isDeleted
          ? (request.resource.data.get('isActive', null) == false
            && isPersistedTimestamp(deletedAt)
            && validNonEmptyString(deletedByUid, 512))
          : (deletedAt == null
            && deletedByUid == null
            && deletedByName == null
            && deleteReason == null));
    }

    function validChargeAbnormalityCreate(docId) {
      let sourceChargeNo = request.resource.data.get('sourceChargeNo', -1);
      let reannealingStatus =
        request.resource.data.get('reannealingStatus', null);
      let reannealedToChargeNo =
        request.resource.data.get('reannealedToChargeNo', null);
      let warningId = 'abnormality_' + docId;
      return canLogChargeAbnormality()
        && requiredAbnormalityQualityWarningExists(docId)
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'sourceChargeNo',
          'abnormalityTypeId',
          'abnormalityTypeTitle',
          'abnormalityTypeCode',
          'category',
          'severity',
          'affectedAssets',
          'component',
          'observedReason',
          'description',
          'possibleRootReasonCategory',
          'possibleRootReasonNotes',
          'reannealingStatus',
          'reannealedToChargeNo',
          'loggedAt',
          'updatedAt',
          'loggedByUid',
          'loggedByName',
          'updatedByUid',
          'updatedByName',
          'linkedTicketFirestoreId',
          'linkedExecutionFirestoreId',
          'version',
          'isDeleted',
          'deletedAt',
          'deletedByUid',
          'deletedByName',
          'deleteReason'
        ])
        && request.resource.data.keys().hasOnly([
          'firestoreId',
          'sourceChargeNo',
          'abnormalityTypeId',
          'abnormalityTypeTitle',
          'abnormalityTypeCode',
          'category',
          'severity',
          'affectedAssets',
          'component',
          'observedReason',
          'description',
          'possibleRootReasonCategory',
          'possibleRootReasonNotes',
          'reannealingStatus',
          'reannealedToChargeNo',
          'loggedAt',
          'updatedAt',
          'loggedByUid',
          'loggedByName',
          'updatedByUid',
          'updatedByName',
          'linkedTicketFirestoreId',
          'linkedExecutionFirestoreId',
          'version',
          'isDeleted',
          'deletedAt',
          'deletedByUid',
          'deletedByName',
          'deleteReason'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && isFiveDigitChargeNumber(sourceChargeNo)
        && validNonEmptyString(
          request.resource.data.get('abnormalityTypeId', null),
          512
        )
        && validNonEmptyString(
          request.resource.data.get('abnormalityTypeTitle', null),
          500
        )
        && validNonEmptyString(
          request.resource.data.get('abnormalityTypeCode', null),
          160
        )
        && (
          request.resource.data.get('category', null) == 'process'
          || request.resource.data.get('category', null) == 'equipment'
          || request.resource.data.get('category', null) == 'resultQuality'
          || request.resource.data.get('category', null) == 'reannealing'
          || request.resource.data.get('category', null) == 'other'
        )
        && (
          request.resource.data.get('severity', null) == 'low'
          || request.resource.data.get('severity', null) == 'medium'
          || request.resource.data.get('severity', null) == 'high'
          || request.resource.data.get('severity', null) == 'critical'
        )
        && request.resource.data.get('affectedAssets', []) is list
        && request.resource.data.get('affectedAssets', []).size() <= 50
        && validOptionalString(
          request.resource.data.get('component', null),
          200
        )
        && validNonEmptyString(
          request.resource.data.get('observedReason', null),
          2000
        )
        && validOptionalString(
          request.resource.data.get('description', null),
          4000
        )
        && (
          request.resource.data.get('possibleRootReasonCategory', null)
            == 'unknown'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'baseRelated'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'furnaceRelated'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'forceCoolerRelated'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'atmosphereRelated'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'thermocoupleTemperature'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'cycleInterruption'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'materialOrCoilCondition'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'operationsRelated'
          || request.resource.data.get('possibleRootReasonCategory', null)
            == 'other'
        )
        && validOptionalString(
          request.resource.data.get('possibleRootReasonNotes', null),
          4000
        )
        && (
          reannealingStatus == 'notApplicable'
          || reannealingStatus == 'pendingDecision'
          || reannealingStatus == 'required'
          || reannealingStatus == 'notRequired'
          || reannealingStatus == 'completed'
        )
        && (
          (
            reannealedToChargeNo == null
            && reannealingStatus != 'completed'
          )
          || (
            isFiveDigitChargeNumber(reannealedToChargeNo)
            && reannealedToChargeNo != sourceChargeNo
            && reannealingStatus == 'completed'
          )
        )
        && validNonEmptyString(
          request.resource.data.get('loggedAt', null),
          64
        )
        && validNonEmptyString(
          request.resource.data.get('updatedAt', null),
          64
        )
        && request.resource.data.get('loggedByUid', null) == request.auth.uid
        && validOptionalString(
          request.resource.data.get('loggedByName', null),
          500
        )
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && validOptionalString(
          request.resource.data.get('updatedByName', null),
          500
        )
        && validOptionalString(
          request.resource.data.get('linkedTicketFirestoreId', null),
          512
        )
        && validOptionalString(
          request.resource.data.get('linkedExecutionFirestoreId', null),
          512
        )
        && request.resource.data.get('version', -1) == 1
        && request.resource.data.get('isDeleted', null) == false
        && request.resource.data.get('deletedAt', null) == null
        && request.resource.data.get('deletedByUid', null) == null
        && request.resource.data.get('deletedByName', null) == null
        && request.resource.data.get('deleteReason', null) == null;
    }

    function validQualityWarningCommon(docId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'warningId',
          'sourceType',
          'sourceId',
          'sourceVersion',
          'sourceChargeNo',
          'sourceSummary',
          'sourceSeverity',
          'warningReason',
          'affectedAssets',
          'component',
          'status',
          'closureRequestReason',
          'closureRequestedAt',
          'closureRequestedByUid',
          'closureRequestedByName',
          'closedAt',
          'closedByUid',
          'closedByName',
          'closureDisposition',
          'linkedReannealingChargeNos',
          'decisionReason',
          'createdAt',
          'createdByUid',
          'createdByName',
          'updatedAt',
          'updatedByUid',
          'updatedByName',
          'version'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'warningId',
          'sourceType',
          'sourceId',
          'sourceVersion',
          'sourceChargeNo',
          'sourceSummary',
          'sourceSeverity',
          'warningReason',
          'affectedAssets',
          'component',
          'status',
          'closureRequestReason',
          'closureRequestedAt',
          'closureRequestedByUid',
          'closureRequestedByName',
          'closedAt',
          'closedByUid',
          'closedByName',
          'closureDisposition',
          'linkedReannealingChargeNos',
          'decisionReason',
          'createdAt',
          'createdByUid',
          'createdByName',
          'updatedAt',
          'updatedByUid',
          'updatedByName',
          'version'
        ])
        && request.resource.data.get('schemaVersion', -1) == 1
        && request.resource.data.get('warningId', null) == docId
        && request.resource.data.get('sourceId', null) is string
        && request.resource.data.get('sourceVersion', -1) is int
        && request.resource.data.get('sourceVersion', -1) >= 1
        && isFiveDigitChargeNumber(
          request.resource.data.get('sourceChargeNo', -1)
        )
        && validNonEmptyString(
          request.resource.data.get('sourceSummary', null),
          2000
        )
        && validNonEmptyString(
          request.resource.data.get('sourceSeverity', null),
          40
        )
        && validNonEmptyString(
          request.resource.data.get('warningReason', null),
          2000
        )
        && request.resource.data.get('affectedAssets', null) is list
        && request.resource.data.get('affectedAssets', []).size() > 0
        && request.resource.data.get('affectedAssets', []).size() <= 50
        && validOptionalString(
          request.resource.data.get('component', null),
          200
        )
        && request.resource.data.get('status', null) == 'open'
        && request.resource.data.get('closureRequestReason', null) == null
        && request.resource.data.get('closureRequestedAt', null) == null
        && request.resource.data.get('closureRequestedByUid', null) == null
        && request.resource.data.get('closureRequestedByName', null) == null
        && request.resource.data.get('closedAt', null) == null
        && request.resource.data.get('closedByUid', null) == null
        && request.resource.data.get('closedByName', null) == null
        && request.resource.data.get('closureDisposition', null) == null
        && request.resource.data.get('linkedReannealingChargeNos', null) is list
        && request.resource.data.get('linkedReannealingChargeNos', []).size() == 0
        && request.resource.data.get('decisionReason', null) == null
        && isPersistedTimestamp(request.resource.data.get('createdAt', null))
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && validOptionalString(
          request.resource.data.get('createdByName', null),
          200
        )
        && request.resource.data.get('updatedAt', null) ==
          request.resource.data.get('createdAt', null)
        && request.resource.data.get('updatedByUid', null) ==
          request.resource.data.get('createdByUid', null)
        && request.resource.data.get('updatedByName', null) ==
          request.resource.data.get('createdByName', null)
        && request.resource.data.get('version', -1) == 1;
    }

    function initialQualityWarningProjection(warning, warningId) {
      return warning.get('schemaVersion', -1) == 1
        && warning.get('warningId', null) == warningId
        && warning.get('status', null) == 'open'
        && warning.get('closureRequestReason', null) == null
        && warning.get('closureRequestedAt', null) == null
        && warning.get('closureRequestedByUid', null) == null
        && warning.get('closureRequestedByName', null) == null
        && warning.get('closedAt', null) == null
        && warning.get('closedByUid', null) == null
        && warning.get('closedByName', null) == null
        && warning.get('closureDisposition', null) == null
        && warning.get('linkedReannealingChargeNos', null) is list
        && warning.get('linkedReannealingChargeNos', []).size() == 0
        && warning.get('decisionReason', null) == null
        && warning.get('updatedAt', null) == warning.get('createdAt', null)
        && warning.get('updatedByUid', null) ==
          warning.get('createdByUid', null)
        && warning.get('updatedByName', null) ==
          warning.get('createdByName', null)
        && warning.get('version', -1) == 1;
    }

    function requiredAbnormalityQualityWarningExists(docId) {
      let warningId = 'abnormality_' + docId;
      let warningPath =
        /databases/$(database)/documents/quality_warnings/$(warningId);
      let warning = getAfter(warningPath).data;
      return (!exists(warningPath) && existsAfter(warningPath))
        || (exists(warningPath)
        && initialQualityWarningProjection(warning, warningId)
        && warning.get('sourceType', null) == 'abnormality'
        && warning.get('sourceId', null) == docId
        && warning.get('sourceVersion', -1) ==
          request.resource.data.get('version', -2)
        && warning.get('sourceChargeNo', -1) ==
          request.resource.data.get('sourceChargeNo', -2)
        && warning.get('sourceSummary', null) ==
          request.resource.data.get('abnormalityTypeTitle', null)
        && warning.get('sourceSeverity', null) ==
          request.resource.data.get('severity', null)
        && warning.get('warningReason', null) ==
          request.resource.data.get('observedReason', null)
        && warning.get('affectedAssets', []) ==
          request.resource.data.get('affectedAssets', [])
        && warning.get('component', null) ==
          request.resource.data.get('component', null)
        && warning.get('createdAt', null) ==
          request.resource.data.get('loggedAt', null)
        && warning.get('createdByUid', null) ==
          request.resource.data.get('loggedByUid', null)
        && warning.get('createdByName', null) ==
          request.resource.data.get('loggedByName', null));
    }

    function validAbnormalityQualityWarning(docId) {
      let sourceId = request.resource.data.get('sourceId', '');
      let sourcePath = /databases/$(database)/documents/charge_abnormalities/$(sourceId);
      let source = getAfter(sourcePath).data;
      return request.resource.data.get('sourceType', null) == 'abnormality'
        && docId == 'abnormality_' + sourceId
        && existsAfter(sourcePath)
        && source.get('firestoreId', null) == sourceId
        && request.resource.data.get('sourceVersion', -1) ==
          source.get('version', -2)
        && request.resource.data.get('sourceChargeNo', -1) ==
          source.get('sourceChargeNo', -2)
        && request.resource.data.get('sourceSummary', null) ==
          source.get('abnormalityTypeTitle', null)
        && request.resource.data.get('sourceSeverity', null) ==
          source.get('severity', null)
        && request.resource.data.get('warningReason', null) ==
          source.get('observedReason', null)
        && request.resource.data.get('affectedAssets', []) ==
          source.get('affectedAssets', [])
        && request.resource.data.get('component', null) ==
          source.get('component', null)
        && request.resource.data.get('createdAt', null) ==
          source.get('loggedAt', null)
        && request.resource.data.get('createdByUid', null) ==
          source.get('loggedByUid', null)
        && request.resource.data.get('createdByName', null) ==
          source.get('loggedByName', null);
    }

    function validQualityWarningCreate(docId) {
      return isApprovedUser()
        && globalPullStampAbsentOnCreate()
        && validQualityWarningCommon(docId)
        && validAbnormalityQualityWarning(docId);
    }

    // ─────────────────────────────────────────────
    // 🛡️ AUDIT HELPERS
    // ─────────────────────────────────────────────

    function validNonEmptyString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null
        || (
          value is string
          && value.size() <= maxLength
        );
    }

    function validAuditActionValue(action) {
      return action == 'create'
        || action == 'update'
        || action == 'resolve'
        || action == 'reopen'
        || action == 'delete'
        || action == 'seed_baseline';
    }

    function validAuditSeverityValue(severity) {
      return severity == 'low'
        || severity == 'medium'
        || severity == 'high';
    }

    function validStandardAuditCreate() {
      return request.resource.data.keys().hasAll([
          'entityType',
          'entityId',
          'action',
          'performedByUid',
          'timestamp',
          'severity'
        ])
        && request.resource.data.keys().hasOnly([
          'entityType',
          'entityId',
          'action',
          'performedByUid',
          'performedByName',
          'timestamp',
          'reason',
          'reasonNotes',
          'summary',
          'severity',
          'beforeJson',
          'afterJson'
        ])
        && validNonEmptyString(request.resource.data.get('entityType', null), 80)
        && validNonEmptyString(request.resource.data.get('entityId', null), 200)
        && validAuditActionValue(request.resource.data.get('action', null))
        && request.resource.data.get('performedByUid', null) == request.auth.uid
        && validOptionalString(request.resource.data.get('performedByName', null), 160)
        && request.resource.data.get('timestamp', null) is timestamp
        && validAuditSeverityValue(request.resource.data.get('severity', null))
        && validOptionalString(request.resource.data.get('reason', null), 80)
        && validOptionalString(request.resource.data.get('reasonNotes', null), 2000)
        && validOptionalString(request.resource.data.get('summary', null), 500)
        && validOptionalString(request.resource.data.get('beforeJson', null), 20000)
        && validOptionalString(request.resource.data.get('afterJson', null), 20000);
    }

    function validKnowledgeSeedAuditCreate() {
      return request.resource.data.keys().hasAll([
          'type',
          'action',
          'performedByUid',
          'performedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'action',
          'performedByUid',
          'performedByName',
          'performedAt',
          'details',
          'matrixVersion',
          'rowCount',
          'version',
          'isDeleted'
        ])
        && request.resource.data.get('type', null) == 'knowledge_base_seed'
        && request.resource.data.get('action', null) == 'seed_baseline'
        && request.resource.data.get('performedByUid', null) == request.auth.uid
        && validOptionalString(request.resource.data.get('performedByName', null), 160)
        && request.resource.data.get('performedAt', null) is timestamp
        && validOptionalString(request.resource.data.get('details', null), 2000)
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false;
    }

    function validAuditCreate() {
      return isApprovedUser()
        && (
          validStandardAuditCreate()
          || validKnowledgeSeedAuditCreate()
        );
    }

    // ─────────────────────────────────────────────
    // 👤 USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if validPendingUserCreate(userId);

      allow update: if exists(/databases/$(database)/documents/users/$(userId))
        ? (validSelfUserUpdate(userId)
          || validAdminUserProfileUpdate(userId))
        : false;

      allow delete: if false;

      match /notification_installations/{installationId} {
        allow read: if false;
        allow create, update: if validNotificationInstallationWrite(
          userId,
          installationId
        );
        allow delete: if canWriteOwnNotificationInstallation(userId);
      }
    }

    // ─────────────────────────────────────────────
    // 🧠 BAF KNOWLEDGE BASE
    // ─────────────────────────────────────────────

    match /knowledge_base/{docId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        ? (
          globalPullStampAbsentOnCreate()
          && validKnowledgeBaseCreate(docId)
        )
        : false;
      allow update: if exists(/databases/$(database)/documents/knowledge_base/$(docId))
        ? (
          isApprovedUser()
            ? (
              globalPullStampValidOnUpdate()
              && validKnowledgeBaseUpdate(docId)
            )
            : false
        )
        : false;
      allow delete: if false;
    }

    match /knowledge_base_meta/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if validKnowledgeMetaWrite(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🏭 GOVERNED ASSET HIERARCHY
    // ─────────────────────────────────────────────

    match /asset_classes/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /asset_class_codes/{docId} {
      allow read, write: if false;
    }

    match /asset_hierarchy_nodes/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /asset_instances/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /asset_instance_numbers/{docId} {
      allow read, write: if false;
    }

    match /asset_component_instances/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /asset_hierarchy_audits/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /asset_tag_claims/{docId} {
      allow get: if isApprovedUser();
      allow list, write: if false;
    }

    match /asset_hierarchy_mutation_receipts/{docId} {
      allow read, write: if false;
    }

    match /frequent_issue_definitions/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /frequent_issue_definition_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /issue_governance_review_queue/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /maintenance_class_definitions/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_class_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /maintenance_classification_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /maintenance_completion_events/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_completion_sources/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /historical_maintenance_records/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /historical_maintenance_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /maintenance_due_states/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_plans/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_plan_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /inspection_definitions/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_definition_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /inspection_campaigns/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_campaign_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /inspection_target_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create, update, delete: if false;
    }

    match /inspection_observations/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_issue_links/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_findings/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_finding_events/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /inspection_verifications/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /asset_operational_conditions/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /asset_operational_condition_audits/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /asset_operational_condition_receipts/{docId} {
      allow read, write: if false;
    }

    match /furnace_stuckup_cases/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /asset_availability_constraints/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /asset_availability_current/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /asset_condition_declarations/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /asset_condition_evidence/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /burner_condition_rounds/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /burner_condition_round_receipts/{docId} {
      allow read, write: if false;
    }

    match /inner_cover_profiles/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /base_inner_cover_assignments/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /inner_cover_linkages/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /inner_cover_fabrications/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /inner_cover_serial_claims/{docId} {
      allow read, write: if false;
    }

    match /inner_cover_donor_part_claims/{docId} {
      allow read, write: if false;
    }

    match /inner_cover_lifecycle_audits/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inner_cover_lifecycle_receipts/{docId} {
      allow read, write: if false;
    }

    match /operational_events/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /operational_event_audits/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /operational_event_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /operational_event_issue_links/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /operational_event_issue_link_audits/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /operational_event_issue_link_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🔧 MAINTENANCE RECORDS
    // ─────────────────────────────────────────────

    match /maintenance_records/{docId} {
      allow read: if isApprovedUser();
      // New issues are created only by the idempotent backend command, which
      // also writes quality/directive projections and immutable audit evidence.
      allow create: if false;
      // A single transition router prevents Firestore from evaluating four
      // independent update allow expressions for the same request.
      allow update: if globalPullStampValidOnUpdate()
        && validMaintenanceUpdate();
      allow delete: if false;
    }

    match /maintenance_burner_closures/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if validBurnerClosureEvidenceWrite(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧬 TEMPLATE GOVERNANCE
    // ─────────────────────────────────────────────

    match /template_packages/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validTemplatePackageCreate(docId);
      allow update: if globalPullStampValidOnUpdate()
        && validTemplatePackageUpdate(docId);
      allow delete: if false;
    }

    match /template_versions/{docId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        ? (
          globalPullStampAbsentOnCreate()
          && validTemplateVersionCreate(docId)
        )
        : false;
      allow update: if globalPullStampValidOnUpdate()
        && validTemplateVersionUpdate(docId);
      allow delete: if false;
    }

    match /template_publish_audits/{docId} {
      // All approved users pull publication readiness evidence. Writes remain
      // governor-only and immutable.
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validTemplatePublishAuditCreate(docId);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧩 GOVERNED MODULE REGISTRY
    // ─────────────────────────────────────────────

    match /module_registry/{registryModuleId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        ? validModuleRegistryFamilyCreate(registryModuleId)
        : false;
      allow update: if validModuleRegistryFamilyUpdate(registryModuleId);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isApprovedUser();
        allow create: if isApprovedUser()
          ? validModuleRegistryRevisionCreate(registryModuleId, revisionId)
          : false;
        allow update: if validModuleRegistryRevisionUpdate(registryModuleId, revisionId);
        allow delete: if false;
      }
    }


    match /module_registry_audits/{docId} {
      allow read: if isAdminOrSI();
      allow create: if validModuleRegistryAuditCreate(docId);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧩 JOB TEMPLATES
    // ─────────────────────────────────────────────

    match /job_templates/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validLegacyJobTemplateCreate();
      allow update: if globalPullStampValidOnUpdate()
        && validLegacyJobTemplateUpdate();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // ⚙️ JOB EXECUTIONS
    // ─────────────────────────────────────────────

    match /job_executions/{docId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        ? (
          globalPullStampAbsentOnCreate()
          && validJobExecutionCreate(docId)
        )
        : false;
      allow update: if exists(/databases/$(database)/documents/job_executions/$(docId))
        ? (
          isApprovedUser()
            ? (
              globalPullStampValidOnUpdate()
              && validJobExecutionUpdate(docId)
            )
            : false
        )
        : false;
      allow delete: if false;
    }

    // Server-only idempotency receipts for governed assignment.
    match /published_template_assignment_requests/{docId} {
      allow read, create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 📝 JOB DIARY ENTRIES
    // ─────────────────────────────────────────────

    match /job_diary_entries/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validJobDiaryCreate(docId);
      allow update: if exists(/databases/$(database)/documents/job_diary_entries/$(docId))
        ? (
          isApprovedUser()
            ? (
              globalPullStampValidOnUpdate()
              && validJobDiaryUpdate(docId)
            )
            : false
        )
        : false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧱 JOB MODULES
    // ─────────────────────────────────────────────

    match /job_modules/{docId} {
      allow read: if isApprovedUser();
      // All client-originated population creates are server-only. Governed
      // published-template assignment uses the Admin SDK and bypasses rules.
      allow create: if false;
      allow update: if globalPullStampValidOnUpdate()
        && validJobModuleUpdate(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 📢 DIRECTIVES
    // ─────────────────────────────────────────────

    match /directives/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validDirectiveCreate(docId);
      allow update: if globalPullStampValidOnUpdate()
        && validDirectiveUpdate();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🔋 CHARGES
    // Base Charge is reserved for future IoT / Level-2 / plant integration.
    // Current app-owned operational sync scope is Charge Abnormality only.
    // ─────────────────────────────────────────────

    match /charges/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // ⚠️ ABNORMALITY TYPES
    // ─────────────────────────────────────────────

    match /abnormality_types/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && isAdmin()
        && targetTombstoneHasDeletionAuthority()
        && validAbnormalityTypeWrite(docId);
      allow update: if globalPullStampValidOnUpdate()
        && isAdmin()
        && targetTombstoneHasDeletionAuthority()
        && validAbnormalityTypeWrite(docId)
        && (
          resource.data.get('version', null) is int
            ? request.resource.data.get('version', -1) ==
              resource.data.get('version', -1) + 1
            : request.resource.data.get('version', -1) >= 1
        );
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧾 CHARGE ABNORMALITIES
    // ─────────────────────────────────────────────

    match /charge_abnormalities/{docId} {
      allow read: if isApprovedUser();
      allow create: if globalPullStampAbsentOnCreate()
        && validChargeAbnormalityCreate(docId);
      // Admin edits and soft deletes are transactionally coupled to immutable
      // audit and replay evidence by mutateChargeAbnormality.
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // ✅ QUALITY WARNINGS AND MONITORING
    // ─────────────────────────────────────────────

    match /quality_warnings/{docId} {
      allow read: if isApprovedUser();
      allow create: if validQualityWarningCreate(docId);
      // Exact no-op projection retries are safe. Every lifecycle change is
      // committed by the governed quality command through the Admin SDK.
      allow update: if isApprovedUser()
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /quality_monitoring_requests/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /quality_mutation_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🔀 MAINTENANCE WORKFLOW — ONLINE COMMAND AUTHORITY
    // ─────────────────────────────────────────────

    match /maintenance_workflows/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /job_lanes/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /compliance_requests/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /compliance_attempts/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /equipment_status/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /equipment_prompt_master/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_workflow_events/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    match /maintenance_workflow_command_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /user_authority_mutation_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /charge_abnormality_mutation_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /workflow_notification_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /notification_event_receipts/{docId} {
      allow read, create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🛡️ AUDIT LOGS
    // ─────────────────────────────────────────────

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      // Deterministic server-population audit identities are reserved for the
      // Admin-SDK transaction and cannot be pre-created by a client.
      allow create: if !docId.matches('^server_module_population_.*')
        && !docId.matches('^server_authority_.*')
        && !docId.matches('^server_charge_abnormality_.*')
        && !docId.matches('^server_maintenance_ticket_.*')
        && validAuditCreate();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🚫 DEFAULT DENY
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
