    function validTemplateVersionUpdateCommon(docId) {
      return isTemplateGovernor()
        && resource.data.firestoreId == docId
        && templateVersionIdentityUnchanged()
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function validDraftTemplateVersionUpdateDelta() {
      return resource.data.status == 'draft'
        && request.resource.data.status == 'draft';
    }

    function validTemplateVersionPublishDelta() {
      return resource.data.status == 'draft'
        && request.resource.data.status == 'published'
        && templateVersionPayloadJsonUnchanged()
        && templateContentHashLooksValid()
        && closureReviewPolicySatisfied()
        && request.resource.data.publishedByUid == request.auth.uid
        && request.resource.data.publishedAt != null;
