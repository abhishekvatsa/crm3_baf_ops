        && request.resource.data.get('sourceChargeNo', -1) is int
        && request.resource.data.get('abnormalityTypeId', null) is string
        && request.resource.data.get('abnormalityTypeTitle', null) is string
        && request.resource.data.get('abnormalityTypeCode', null) is string
        && request.resource.data.get('category', null) is string
        && request.resource.data.get('severity', null) is string
        && request.resource.data.get('affectedAssets', []) is list
        && request.resource.data.get('observedReason', null) is string
        && request.resource.data.get('loggedAt', null) is string
        && request.resource.data.get('updatedAt', null) is string
        && request.resource.data.get('loggedByUid', null) == request.auth.uid
