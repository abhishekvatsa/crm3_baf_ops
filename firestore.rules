    function maintenanceWorkflowFields() {
      return [
          'workflowDeferred',
          'workflowQueueState',
          'workflowAggregateId',
          'workflowComplianceId',
          'workflowOriginLaneKey',
          'workflowTargetLaneKey',
          'workflowConditionTypeKey',
          'workflowConditionRef',
          'workflowDeferredAt',
