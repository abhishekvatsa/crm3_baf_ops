    function validTemplateVersionRetireDelta() {
      return resource.data.status == 'published'
        && request.resource.data.status == 'retired'
        && templateVersionFrozenPayloadUnchanged()
        && request.resource.data.retiredByUid == request.auth.uid
        && request.resource.data.retiredAt != null
        && request.resource.data.retireReason is string;
    }

    function validTemplateVersionArchiveDelta() {
      return resource.data.status == 'retired'
        && request.resource.data.status == 'archived'
        && templateVersionFrozenPayloadUnchanged();
    }

    function validTemplateVersionUpdate(docId) {
      return validTemplateVersionUpdateCommon(docId)
        && (
          validDraftTemplateVersionUpdateDelta()
          || validTemplateVersionPublishDelta()
          || validTemplateVersionRetireDelta()
          || validTemplateVersionArchiveDelta()
        );
