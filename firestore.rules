rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 🔹 HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApprovedUser() {
      return hasUserDoc()
        && userDoc().data.isApproved == true
        && userDoc().data.roles is list;
    }

    function hasAnyRole(roles) {
      return isApprovedUser()
        && userDoc().data.roles.hasAny(roles);
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isAdminOrSI() {
      return hasAnyRole(['admin', 'si']);
    }

    function isModuleLifecycleModerator() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor'
      ]);
    }

    function isJobExecutionAssigner() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'seniorMechanical',
        'seniorElectrical',
        'seniorInstrumentation',
        'seniorRefractory'
      ]);
    }

    function canAddJobModuleDuringExecution() {
      return isJobExecutionAssigner();
    }

    function canCreateJobDiaryEntry() {
      return isJobExecutionAssigner();
    }

    function canCloseMaintenanceTicket() {
      return isJobExecutionAssigner();
    }

    function canReopenMaintenanceTicket() {
      return hasAnyRole(['admin', 'si', 'operations']);
    }

    function canLogChargeAbnormality() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'operations'
      ]);
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validPendingUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'roles',
          'isApproved',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'roles',
          'isApproved',
          'fcmToken',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.roles is list
        && request.resource.data.roles.hasAll(['operations'])
        && request.resource.data.roles.hasOnly(['operations'])
        && request.resource.data.isApproved == false
        && request.resource.data.createdAt is timestamp;
    }

    function validSelfUserUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'fcmToken'
        ])
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.isApproved == resource.data.isApproved
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validAdminUserWrite(userId) {
      return isAdmin()
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.isApproved is bool
        && (
          request.auth.uid != userId
          || request.resource.data.roles.hasAny(['admin'])
        );
    }

    // ─────────────────────────────────────────────
    // 🧩 LEGACY JOB TEMPLATE HELPERS
    // ─────────────────────────────────────────────

    function validLegacyJobTemplateCreate() {
      return isAdminOrSI()
        && request.resource.data.get('isDeleted', false) == false;
    }

    function validLegacyJobTemplateUpdate() {
      return (
          isAdminOrSI()
          && request.resource.data.get('isDeleted', false) ==
            resource.data.get('isDeleted', false)
        )
        || (
          isAdmin()
          && resource.data.get('isDeleted', false) == false
          && request.resource.data.get('isDeleted', false) == true
        );
    }

    // ─────────────────────────────────────────────
    // ⚙️ JOB EXECUTION HELPERS
    // ─────────────────────────────────────────────

    function jobExecutionAllowedFields() {
      return [
        'firestoreId',
        'templateFirestoreId',
        'templateName',
        'templatePackageId',
        'templateVersionId',
        'templateVersionNumber',
        'templateVersionLabel',
        'templateContentHash',
        'templatePackageCode',
        'assetType',
        'assetNumber',
        'isCompleted',
        'assignedByUid',
        'assignedByName',
        'assignedAgencies',
        'completedByUid',
        'completedByName',
        'remarks',
        'teamsInvolved',
        'chargeNoAtEvent',
        'responsesJson',
        'actionsJson',
        'version',
        'metadataJson',
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'createdAt',
        'completedAt',
        'updatedAt'
      ];
    }

    function validJobExecutionCreate(docId) {
      return isJobExecutionAssigner()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'templateFirestoreId',
          'assetType',
          'assetNumber',
          'assignedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isCompleted',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly(jobExecutionAllowedFields())
        && request.resource.data.firestoreId == docId
        && request.resource.data.templateFirestoreId is string
        && request.resource.data.assetType is string
        && request.resource.data.assetNumber is int
        && request.resource.data.assignedByUid is string
        && request.resource.data.assignedByUid == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.get('isCompleted', false) == false
        && request.resource.data.get('isDeleted', false) == false;
    }

    function validJobExecutionBaseUpdate(docId) {
      return isApprovedUser()
        && resource.data.firestoreId == docId
        && request.resource.data.firestoreId == resource.data.firestoreId
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.templateFirestoreId == resource.data.templateFirestoreId
        && request.resource.data.get('templatePackageId', null) == resource.data.get('templatePackageId', null)
        && request.resource.data.get('templateVersionId', null) == resource.data.get('templateVersionId', null)
        && request.resource.data.get('templateVersionNumber', null) == resource.data.get('templateVersionNumber', null)
        && request.resource.data.get('templateContentHash', null) == resource.data.get('templateContentHash', null)
        && request.resource.data.assetNumber == resource.data.assetNumber
        && request.resource.data.assetType == resource.data.assetType
        && request.resource.data.get('assignedByUid', null) == resource.data.get('assignedByUid', null)
        && request.resource.data.get('assignedByName', null) == resource.data.get('assignedByName', null)
        && request.resource.data.get('assignedAgencies', []) == resource.data.get('assignedAgencies', [])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function jobExecutionWorkChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'remarks',
        'teamsInvolved',
        'responsesJson',
        'actionsJson',
        'metadataJson',
        'updatedAt',
        'version'
      ]);
    }

    function validJobExecutionWorkUpdate() {
      return isJobExecutionAssigner()
        && resource.data.isCompleted == false
        && request.resource.data.isCompleted == false
        && jobExecutionWorkChangedFieldsOnly();
    }

    function validJobExecutionComplete() {
      // M6 full closure enforcement:
      // client SDKs may no longer complete JobExecution documents directly.
      // Final completion is performed only by the trusted Cloud Function
      // completePlannedJobExecution, which uses the Admin SDK and therefore
      // bypasses Firestore rules after validating the current job_modules
      // server-side. This prevents stale or tampered clients from bypassing the
      // module-closure invariant that rules cannot query here.
      return false;
    }

    function validJobExecutionUpdate(docId) {
      return validJobExecutionBaseUpdate(docId)
        && (
          validJobExecutionWorkUpdate()
          || validJobExecutionComplete()
        );
    }

    // ─────────────────────────────────────────────
    // 🧱 JOB MODULE HELPERS
    // ─────────────────────────────────────────────

    function rolesCanSaveJobModuleWork(roles) {
      return roles.hasAny([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'seniorMechanical',
        'seniorElectrical',
        'seniorInstrumentation',
        'seniorRefractory'
      ]);
    }

    function rolesAreModuleLifecycleModerator(roles) {
      return roles.hasAny([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor'
      ]);
    }

    function rolesCanSubmitJobModuleDiscipline(roles, discipline) {
      return rolesAreModuleLifecycleModerator(roles)
        || (
          (discipline == 'mechanical' && roles.hasAny(['seniorMechanical']))
          || (discipline == 'electrical' && roles.hasAny(['seniorElectrical']))
          || (
            (
              discipline == 'instrumentation'
              || discipline == 'instrument'
              || discipline == 'ia'
              || discipline == 'iAndA'
              || discipline == 'instrumentationAndAutomation'
              || discipline == 'instrumentationAutomation'
            )
            && roles.hasAny(['seniorInstrumentation'])
          )
          || (
            (discipline == 'refractory' || discipline == 'others')
            && roles.hasAny(['seniorRefractory'])
          )
        );
    }

    function isElevatedRuntimeModuleCreate() {
      return request.resource.data.get('addedDuringExecution', false) == true
        && (
          request.resource.data.get('requiredForClosure', false) == true
          || request.resource.data.get('discipline', '') == 'shared'
          || request.resource.data.get('safetyClass', 'normal') != 'normal'
        );
    }

    function validRuntimeModuleCreateAuthority() {
      return !isElevatedRuntimeModuleCreate()
        || isModuleLifecycleModerator();
    }

    function validJobModuleCreatePayload(docId) {
      return request.resource.data.firestoreId == docId
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'moduleTitle',
          'assetType',
          'assetNumber',
          'status',
          'discipline',
          'safetyClass',
          'requiredForClosure',
          'addedDuringExecution',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.moduleTitle is string
        && request.resource.data.assetType is string
        && request.resource.data.assetNumber is int
        && request.resource.data.status is string
        && request.resource.data.discipline is string
        && request.resource.data.safetyClass is string
        && request.resource.data.requiredForClosure is bool
        && request.resource.data.addedDuringExecution is bool
        && request.resource.data.moduleSnapshotJson is string
        && request.resource.data.fieldDefinitionsJson is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.isDeleted == false
        && isApprovedUser()
        && canAddJobModuleDuringExecution()
        && validRuntimeModuleCreateAuthority();
    }

    function validJobModuleCreate(docId) {
      // 47D.3: use a conditional expression rather than `&&` to force
      // malformed local-only/legacy payloads to deny before the expensive
      // authority and payload checks are evaluated by the emulator.
      return request.resource.data.keys().hasAny(['responses', 'isSynced'])
        ? false
        : validJobModuleCreatePayload(docId);
    }

    function validJobModuleUpdateCommon(docId, changedKeys) {
      return !changedKeys.hasAny([
          'firestoreId',
          'createdByUid',
          'createdAt',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'assetType',
          'assetNumber',
          'discipline',
          'responses',
          'isSynced'
        ])
        && isApprovedUser()
        && resource.data.firestoreId == docId
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function isOpenModuleStatus(status) {
      return status == 'notStarted'
        || status == 'draftSaved'
        || status == 'inProgress'
        || status == 'reopened';
    }

    function jobModuleChangedFieldsOnly(changedKeys, allowedFields) {
      return changedKeys.hasOnly(allowedFields);
    }

    function jobModuleCoreWorkChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleSubmitChangedFieldsOnly(changedKeys) {
      // Offline-first tablets can save work and submit before a push occurs,
      // so submit allows the normal mutable work fields plus submit lifecycle fields.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'submittedByUid',
        'submittedByName',
        'submittedAt',
        'submissionNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleAcceptChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'acceptedByUid',
        'acceptedByName',
        'acceptedAt',
        'acceptanceNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleReopenChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'reopenedByUid',
        'reopenedByName',
        'reopenedAt',
        'reopenReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleNotApplicableChangedFieldsOnly(changedKeys) {
      // A tablet may save normal work fields and mark a module not applicable
      // before the next push, so allow the core mutable work fields too.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'notApplicableByUid',
        'notApplicableByName',
        'notApplicableAt',
        'notApplicableReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleSoftDeleteChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'isDeleted',
        'deletedByUid',
        'deletedByName',
        'deletedAt',
        'deleteReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function validJobModuleWorkUpdate(changedKeys, roles) {
      return isOpenModuleStatus(request.resource.data.status)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleCoreWorkChangedFieldsOnly(changedKeys)
        && request.resource.data.updatedByUid is string
        && request.resource.data.updatedByUid == request.auth.uid
        && rolesCanSaveJobModuleWork(roles);
    }

    function validJobModuleSubmit(changedKeys, roles) {
      return request.resource.data.status == 'submitted'
        && isOpenModuleStatus(resource.data.status)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleSubmitChangedFieldsOnly(changedKeys)
        && request.resource.data.submittedByUid == request.auth.uid
        && rolesCanSubmitJobModuleDiscipline(roles, resource.data.discipline);
    }

    function validJobModuleAccept(changedKeys, roles) {
      return request.resource.data.status == 'accepted'
        && resource.data.status == 'submitted'
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleAcceptChangedFieldsOnly(changedKeys)
        && request.resource.data.acceptedByUid == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleReopen(changedKeys, roles) {
      return request.resource.data.status == 'reopened'
        && (
          resource.data.status == 'submitted'
          || resource.data.status == 'accepted'
          || resource.data.status == 'notApplicable'
        )
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleReopenChangedFieldsOnly(changedKeys)
        && request.resource.data.reopenedByUid == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleNotApplicable(changedKeys, roles) {
      return request.resource.data.status == 'notApplicable'
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleNotApplicableChangedFieldsOnly(changedKeys)
        && request.resource.data.notApplicableByUid == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleSoftDelete(changedKeys, roles) {
      return resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == true
        && jobModuleSoftDeleteChangedFieldsOnly(changedKeys)
        && request.resource.data.deletedByUid == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleUpdatePayload(docId, changedKeys, roles) {
      return validJobModuleUpdateCommon(docId, changedKeys)
        && (
          validJobModuleSoftDelete(changedKeys, roles)
          || validJobModuleSubmit(changedKeys, roles)
          || validJobModuleAccept(changedKeys, roles)
          || validJobModuleReopen(changedKeys, roles)
          || validJobModuleNotApplicable(changedKeys, roles)
          || validJobModuleWorkUpdate(changedKeys, roles)
        );
    }

    function validJobModuleUpdate(docId) {
      // 47D.3: use the conditional operator as a true fast-deny boundary.
      // The previous `&&` match-gate still allowed the emulator to evaluate
      // the expensive update OR-chain on malformed `isSynced` / `responses`
      // writes. The selected branch of this conditional should prevent that
      // chain from being evaluated for known local-only/legacy payloads.
      //
      // 47D.4: Guard userDoc().data.roles with isApprovedUser() — without
      // this, a signed-in user with no user doc (deletion in flight, fresh
      // signup before doc creation, admin-removed doc) makes this rule
      // ERROR instead of cleanly deny. Behavior is still deny in the end,
      // but errors-as-deny is a smell and pollutes the rules emulator log
      // with 20+ warnings per negative test run.
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['responses', 'isSynced'])
        ? false
        : (isApprovedUser()
            && validJobModuleUpdatePayload(docId, changedKeys, userDoc().data.roles));
    }

    // ─────────────────────────────────────────────
    // 📝 JOB DIARY HELPERS
    // ─────────────────────────────────────────────

    function validJobDiaryCreate(docId) {
      return canCreateJobDiaryEntry()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'note',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.firestoreId == docId
        && request.resource.data.note is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.isDeleted == false;
    }

    function validJobDiaryUpdate(docId) {
      // Diary notes remain editable by their creator and by Admin/SI.
      // Version must strictly advance and hard/soft delete is not allowed here.
      return isApprovedUser()
        && resource.data.firestoreId == docId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note',
          'updatedByUid',
          'updatedByName',
          'updatedAt',
          'version'
        ])
        && request.resource.data.firestoreId == resource.data.firestoreId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.get('isDeleted', false) == false
        && (
          isAdminOrSI()
          || resource.data.createdByUid == request.auth.uid
        );
    }

    // ─────────────────────────────────────────────
    // 📢 DIRECTIVE HELPERS
    // ─────────────────────────────────────────────

    function canCloseAnyDirective() {
      return isModuleLifecycleModerator();
    }

    function hasRequesterDirectiveTargetRole(role) {
      return isApprovedUser()
        && role is string
        && userDoc().data.roles.hasAny([role]);
    }

    function canDirectiveCreatorTarget(role) {
      return role is string
        && (
          (isAdmin() && role != 'admin')
          || (
            hasAnyRole(['si'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['contractSupervisor'])
            && [
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['shiftSupervisor'])
            && [
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['operations'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
        );
    }

    function directiveIssuedByRequester(data) {
      return data.get('createdByUid', '') == request.auth.uid
        || data.get('issuedByUid', '') == request.auth.uid;
    }

    function directiveAllowedFields() {
      return [
        'firestoreId',
        'title',
        'description',
        'assetType',
        'assetNumber',
        'component',
        'subsystem',
        'tag',
        'hierarchyPath',
        'directedTo',
        'status',
        'priority',
        'createdByUid',
        'createdByName',
        'issuedByUid',
        'issuedByName',
        'issuedAt',
        'isActive',
        'acknowledgedByUid',
        'acknowledgedByName',
        'acknowledgedAt',
        'closedByUid',
        'closedByName',
        'closedAt',
        'closedWithoutAcknowledgement',
        'remarks',
        'linkedMaintenanceFirestoreId',
        'linkedExecutionFirestoreId',
        'metadataJson',
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'createdAt',
        'updatedAt',
        'version'
      ];
    }

    function validDirectiveCreate(docId) {
      return request.resource.data.keys().hasAll([
          'firestoreId',
          'title',
          'description',
          'directedTo',
          'status',
          'createdByUid',
          'issuedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly(directiveAllowedFields())
        && request.resource.data.firestoreId is string
        && request.resource.data.firestoreId == docId
        && request.resource.data.get('isDeleted', false) == false
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.directedTo is string
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.issuedByUid is string
        && request.resource.data.issuedByUid == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && canDirectiveCreatorTarget(request.resource.data.directedTo);
    }

    function validDirectiveBaseUpdate() {
      return isApprovedUser()
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == false
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.issuedByUid == resource.data.issuedByUid
        && request.resource.data.directedTo == resource.data.directedTo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function validDirectiveAcknowledge() {
      return validDirectiveBaseUpdate()
        && resource.data.status == 'open'
        && request.resource.data.status == 'acknowledged'
        && request.resource.data.acknowledgedByUid == request.auth.uid
        && request.resource.data.acknowledgedAt != null
        && hasRequesterDirectiveTargetRole(resource.data.directedTo)
        && request.resource.data.closedByUid == null
        && request.resource.data.closedAt == null;
    }

    function validDirectiveClose() {
      return validDirectiveBaseUpdate()
        && (resource.data.status == 'open' || resource.data.status == 'acknowledged')
        && request.resource.data.status == 'closed'
        && request.resource.data.closedByUid == request.auth.uid
        && request.resource.data.closedAt != null
        && (
          canCloseAnyDirective()
          || directiveIssuedByRequester(resource.data)
          || (
            resource.data.status == 'acknowledged'
            && resource.data.acknowledgedByUid == request.auth.uid
            && hasRequesterDirectiveTargetRole(resource.data.directedTo)
          )
        );
    }

    function validDirectiveAdminEdit() {
      return isAdmin()
        && request.resource.data.get('isDeleted', false) ==
          resource.data.get('isDeleted', false)
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function validDirectiveAdminDelete() {
      return isAdmin()
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == true
        && request.resource.data.deletedByUid == request.auth.uid;
    }

    function validDirectiveUpdate() {
      return validDirectiveAcknowledge()
        || validDirectiveClose()
        || validDirectiveAdminEdit()
        || validDirectiveAdminDelete();
    }

    // ─────────────────────────────────────────────
    // 🧬 TEMPLATE GOVERNANCE HELPERS
