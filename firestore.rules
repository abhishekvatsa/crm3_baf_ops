rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 🔹 HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        ? exists(/databases/$(database)/documents/users/$(request.auth.uid))
        : false;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApprovedUser() {
      return hasUserDoc()
        ? (userDoc().data.keys().hasAll(['isApproved', 'roles'])
          && userDoc().data.get('isApproved', false) == true
          && userDoc().data.get('roles', null) is list)
        : false;
    }

    function hasAnyRole(roles) {
      return isApprovedUser()
        ? userDoc().data.get('roles', []).hasAny(roles)
        : false;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isAdminOrSI() {
      return hasAnyRole(['admin', 'si']);
    }

    function isModuleLifecycleModerator() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor'
      ]);
    }

    function isJobExecutionAssigner() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'seniorMechanical',
        'seniorElectrical',
        'seniorInstrumentation',
        'seniorRefractory'
      ]);
    }

    function canAddJobModuleDuringExecution() {
      return isJobExecutionAssigner();
    }

    function canCreateJobDiaryEntry() {
      return isJobExecutionAssigner();
    }

    function canCloseMaintenanceTicket() {
      return isJobExecutionAssigner();
    }

    function canReopenMaintenanceTicket() {
      return hasAnyRole(['admin', 'si', 'operations']);
    }

    function canLogChargeAbnormality() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'operations'
      ]);
    }

    function isSelf(userId) {
      return isSignedIn()
        ? request.auth.uid == userId
        : false;
    }

    function validPendingUserCreate(userId) {
      return isSelf(userId)
        ? (request.resource.data.keys().hasAll([
            'name',
            'email',
            'roles',
            'isApproved',
            'createdAt'
          ])
          ? (request.resource.data.keys().hasOnly([
              'name',
              'email',
              'photoUrl',
              'roles',
              'isApproved',
              'fcmToken',
              'createdAt'
            ])
            && request.resource.data.get('name', null) is string
            && request.resource.data.get('email', null) is string
            && request.resource.data.get('roles', []) is list
            && request.resource.data.get('roles', []).hasAll(['operations'])
            && request.resource.data.get('roles', []).hasOnly(['operations'])
            && request.resource.data.get('isApproved', null) == false
            && request.resource.data.get('createdAt', null) is timestamp)
          : false)
        : false;
    }

    function validSelfUserUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'fcmToken'
        ])
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('isApproved', null) == resource.data.get('isApproved', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function validAdminUserWrite(userId) {
      return isAdmin()
        ? (request.resource.data.keys().hasAll(['roles', 'isApproved'])
          ? (request.resource.data.get('roles', []) is list
            && request.resource.data.get('roles', []).size() > 0
            && request.resource.data.get('isApproved', null) is bool
            && (
              request.auth.uid != userId
              || request.resource.data.get('roles', []).hasAny(['admin'])
            ))
          : false)
        : false;
    }

    // ─────────────────────────────────────────────
    // 🧩 LEGACY JOB TEMPLATE HELPERS
    // ─────────────────────────────────────────────

    function validLegacyJobTemplateCreate() {
      return isAdminOrSI()
        && request.resource.data.get('isDeleted', false) == false;
    }

    function validLegacyJobTemplateUpdate() {
      return (
          isAdminOrSI()
          && request.resource.data.get('isDeleted', false) ==
            resource.data.get('isDeleted', false)
        )
        || (
          isAdmin()
          && resource.data.get('isDeleted', false) == false
          && request.resource.data.get('isDeleted', false) == true
        );
    }

    // ─────────────────────────────────────────────
    // ⚙️ JOB EXECUTION HELPERS
    // ─────────────────────────────────────────────

    function jobExecutionAllowedFields() {
      return [
        'firestoreId',
        'templateFirestoreId',
        'templateName',
        'templatePackageId',
        'templateVersionId',
        'templateVersionNumber',
        'templateVersionLabel',
        'templateContentHash',
        'templatePackageCode',
        'assetType',
        'assetNumber',
        'isCompleted',
        'assignedByUid',
        'assignedByName',
        'assignedAgencies',
        'completedByUid',
        'completedByName',
        'remarks',
        'teamsInvolved',
        'chargeNoAtEvent',
        'responsesJson',
        'actionsJson',
        'version',
        'metadataJson',
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'createdAt',
        'completedAt',
        'updatedAt'
      ];
    }

    function validJobExecutionCreate(docId) {
      return request.resource.data.keys().hasAll([
          'firestoreId',
          'templateFirestoreId',
          'assetType',
          'assetNumber',
          'assignedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isCompleted',
          'isDeleted'
        ])
        ? (isJobExecutionAssigner()
          && request.resource.data.keys().hasOnly(jobExecutionAllowedFields())
          && request.resource.data.get('firestoreId', null) == docId
          && request.resource.data.get('templateFirestoreId', null) is string
          && request.resource.data.get('assetType', null) is string
          && request.resource.data.get('assetNumber', -1) is int
          && request.resource.data.get('assignedByUid', null) is string
          && request.resource.data.get('assignedByUid', null) == request.auth.uid
          && request.resource.data.get('createdAt', null) is string
          && request.resource.data.get('updatedAt', null) is string
          && request.resource.data.get('version', -1) is int
          && request.resource.data.get('version', -1) >= 1
          && request.resource.data.get('isCompleted', false) == false
          && request.resource.data.get('isDeleted', false) == false)
        : false;
    }

    function validJobExecutionBaseUpdate(docId) {
      return isApprovedUser()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.get('templateFirestoreId', null) == resource.data.get('templateFirestoreId', null)
        && request.resource.data.get('templatePackageId', null) == resource.data.get('templatePackageId', null)
        && request.resource.data.get('templateVersionId', null) == resource.data.get('templateVersionId', null)
        && request.resource.data.get('templateVersionNumber', null) == resource.data.get('templateVersionNumber', null)
        && request.resource.data.get('templateContentHash', null) == resource.data.get('templateContentHash', null)
        && request.resource.data.get('assetNumber', -1) == resource.data.get('assetNumber', -1)
        && request.resource.data.get('assetType', null) == resource.data.get('assetType', null)
        && request.resource.data.get('assignedByUid', null) == resource.data.get('assignedByUid', null)
        && request.resource.data.get('assignedByName', null) == resource.data.get('assignedByName', null)
        && request.resource.data.get('assignedAgencies', []) == resource.data.get('assignedAgencies', [])
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function jobExecutionWorkChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'remarks',
        'teamsInvolved',
        'responsesJson',
        'actionsJson',
        'metadataJson',
        'updatedAt',
        'version'
      ]);
    }

    function validJobExecutionWorkUpdate() {
      return isJobExecutionAssigner()
        && resource.data.get('isCompleted', null) == false
        && request.resource.data.get('isCompleted', null) == false
        && jobExecutionWorkChangedFieldsOnly();
    }

    function validJobExecutionComplete() {
      // M6 full closure enforcement:
      // client SDKs may no longer complete JobExecution documents directly.
      // Final completion is performed only by the trusted Cloud Function
      // completePlannedJobExecution, which uses the Admin SDK and therefore
      // bypasses Firestore rules after validating the current job_modules
      // server-side. This prevents stale or tampered clients from bypassing the
      // module-closure invariant that rules cannot query here.
      return false;
    }

    function validJobExecutionUpdate(docId) {
      return validJobExecutionBaseUpdate(docId)
        && (
          validJobExecutionWorkUpdate()
          || validJobExecutionComplete()
        );
    }

    // ─────────────────────────────────────────────
    // 🧱 JOB MODULE HELPERS
    // ─────────────────────────────────────────────

    function rolesCanSaveJobModuleWork(roles) {
      return roles.hasAny([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'seniorMechanical',
        'seniorElectrical',
        'seniorInstrumentation',
        'seniorRefractory'
      ]);
    }

    function rolesAreModuleLifecycleModerator(roles) {
      return roles.hasAny([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor'
      ]);
    }

    function rolesCanSubmitJobModuleDiscipline(roles, discipline) {
      return rolesAreModuleLifecycleModerator(roles)
        || (
          (discipline == 'mechanical' && roles.hasAny(['seniorMechanical']))
          || (discipline == 'electrical' && roles.hasAny(['seniorElectrical']))
          || (
            (
              discipline == 'instrumentation'
              || discipline == 'instrument'
              || discipline == 'ia'
              || discipline == 'iAndA'
              || discipline == 'instrumentationAndAutomation'
              || discipline == 'instrumentationAutomation'
            )
            && roles.hasAny(['seniorInstrumentation'])
          )
          || (
            (discipline == 'refractory' || discipline == 'others')
            && roles.hasAny(['seniorRefractory'])
          )
        );
    }

    function isElevatedRuntimeModuleCreate() {
      return request.resource.data.get('addedDuringExecution', false) == true
        && (
          request.resource.data.get('requiredForClosure', false) == true
          || request.resource.data.get('discipline', '') == 'shared'
          || request.resource.data.get('safetyClass', 'normal') != 'normal'
        );
    }

    function validRuntimeModuleCreateAuthority() {
      return !isElevatedRuntimeModuleCreate()
        || isModuleLifecycleModerator();
    }

    function validJobModuleCreatePayload(docId) {
      return request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'moduleTitle',
          'assetType',
          'assetNumber',
          'status',
          'discipline',
          'safetyClass',
          'requiredForClosure',
          'addedDuringExecution',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.get('moduleTitle', null) is string
        && request.resource.data.get('assetType', null) is string
        && request.resource.data.get('assetNumber', -1) is int
        && request.resource.data.get('status', null) is string
        && request.resource.data.get('discipline', null) is string
        && request.resource.data.get('safetyClass', null) is string
        && request.resource.data.get('requiredForClosure', null) is bool
        && request.resource.data.get('addedDuringExecution', null) is bool
        && request.resource.data.get('moduleSnapshotJson', null) is string
        && request.resource.data.get('fieldDefinitionsJson', null) is string
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false
        && isApprovedUser()
        && canAddJobModuleDuringExecution()
        && validRuntimeModuleCreateAuthority();
    }

    function validJobModuleCreate(docId) {
      // 47D.3: use a conditional expression rather than `&&` to force
      // malformed local-only/legacy payloads to deny before the expensive
      // authority and payload checks are evaluated by the emulator.
      return request.resource.data.keys().hasAny(['responses', 'isSynced'])
        ? false
        : validJobModuleCreatePayload(docId);
    }

    function validJobModuleUpdateCommon(docId, changedKeys) {
      return !changedKeys.hasAny([
          'firestoreId',
          'createdByUid',
          'createdAt',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'assetType',
          'assetNumber',
          'discipline',
          'responses',
          'isSynced'
        ])
        && isApprovedUser()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function isOpenModuleStatus(status) {
      return status == 'notStarted'
        || status == 'draftSaved'
        || status == 'inProgress'
        || status == 'reopened';
    }

    function jobModuleChangedFieldsOnly(changedKeys, allowedFields) {
      return changedKeys.hasOnly(allowedFields);
    }

    function jobModuleCoreWorkChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleSubmitChangedFieldsOnly(changedKeys) {
      // Offline-first tablets can save work and submit before a push occurs,
      // so submit allows the normal mutable work fields plus submit lifecycle fields.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'submittedByUid',
        'submittedByName',
        'submittedAt',
        'submissionNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleAcceptChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'acceptedByUid',
        'acceptedByName',
        'acceptedAt',
        'acceptanceNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleReopenChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'reopenedByUid',
        'reopenedByName',
        'reopenedAt',
        'reopenReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleNotApplicableChangedFieldsOnly(changedKeys) {
      // A tablet may save normal work fields and mark a module not applicable
      // before the next push, so allow the core mutable work fields too.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'notApplicableByUid',
        'notApplicableByName',
        'notApplicableAt',
        'notApplicableReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleSoftDeleteChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'isDeleted',
        'deletedByUid',
        'deletedByName',
        'deletedAt',
        'deleteReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function validJobModuleWorkUpdate(changedKeys, roles) {
      return isOpenModuleStatus(request.resource.data.get('status', null))
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleCoreWorkChangedFieldsOnly(changedKeys)
        && request.resource.data.get('updatedByUid', null) is string
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && rolesCanSaveJobModuleWork(roles);
    }

    function validJobModuleSubmit(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'submitted'
        && isOpenModuleStatus(resource.data.get('status', null))
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleSubmitChangedFieldsOnly(changedKeys)
        && request.resource.data.get('submittedByUid', null) == request.auth.uid
        && rolesCanSubmitJobModuleDiscipline(roles, resource.data.get('discipline', null));
    }

    function validJobModuleAccept(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'accepted'
        && resource.data.get('status', null) == 'submitted'
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleAcceptChangedFieldsOnly(changedKeys)
        && request.resource.data.get('acceptedByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleReopen(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'reopened'
        && (
          resource.data.get('status', null) == 'submitted'
          || resource.data.get('status', null) == 'accepted'
          || resource.data.get('status', null) == 'notApplicable'
        )
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleReopenChangedFieldsOnly(changedKeys)
        && request.resource.data.get('reopenedByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleNotApplicable(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'notApplicable'
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleNotApplicableChangedFieldsOnly(changedKeys)
        && request.resource.data.get('notApplicableByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleSoftDelete(changedKeys, roles) {
      return resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == true
        && jobModuleSoftDeleteChangedFieldsOnly(changedKeys)
        && request.resource.data.get('deletedByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleUpdatePayload(docId, changedKeys, roles) {
      return validJobModuleUpdateCommon(docId, changedKeys)
        && (
          validJobModuleSoftDelete(changedKeys, roles)
          || validJobModuleSubmit(changedKeys, roles)
          || validJobModuleAccept(changedKeys, roles)
          || validJobModuleReopen(changedKeys, roles)
          || validJobModuleNotApplicable(changedKeys, roles)
          || validJobModuleWorkUpdate(changedKeys, roles)
        );
    }

    function validJobModuleUpdate(docId) {
      // 47D.3: use the conditional operator as a true fast-deny boundary.
      // The previous `&&` match-gate still allowed the emulator to evaluate
      // the expensive update OR-chain on malformed `isSynced` / `responses`
      // writes. The selected branch of this conditional should prevent that
      // chain from being evaluated for known local-only/legacy payloads.
      //
      // 47D.4: Guard userDoc().data.get('roles', []) with isApprovedUser() — without
      // this, a signed-in user with no user doc (deletion in flight, fresh
      // signup before doc creation, admin-removed doc) makes this rule
      // ERROR instead of cleanly deny. Behavior is still deny in the end,
      // but errors-as-deny is a smell and pollutes the rules emulator log
      // with 20+ warnings per negative test run.
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['responses', 'isSynced'])
        ? false
        : (isApprovedUser()
            ? validJobModuleUpdatePayload(docId, changedKeys, userDoc().data.get('roles', []))
            : false);
    }

    // ─────────────────────────────────────────────
    // 📝 JOB DIARY HELPERS
    // ─────────────────────────────────────────────

    function validJobDiaryCreate(docId) {
      return canCreateJobDiaryEntry()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'note',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('note', null) is string
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false;
    }

    function validJobDiaryUpdate(docId) {
      // Diary notes remain editable by their creator and by Admin/SI.
      // Version must strictly advance and hard/soft delete is not allowed here.
      return isApprovedUser()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note',
          'updatedByUid',
          'updatedByName',
          'updatedAt',
          'version'
        ])
        && request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.get('isDeleted', false) == false
        && (
          isAdminOrSI()
          || resource.data.get('createdByUid', null) == request.auth.uid
        );
    }

    // ─────────────────────────────────────────────
    // 📢 DIRECTIVE HELPERS
    // ─────────────────────────────────────────────

    function canCloseAnyDirective() {
      return isModuleLifecycleModerator();
    }

    function hasRequesterDirectiveTargetRole(role) {
      return isApprovedUser()
        ? (role is string && userDoc().data.get('roles', []).hasAny([role]))
        : false;
    }

    function canDirectiveCreatorTarget(role) {
      return role is string
        && (
          (isAdmin() && role != 'admin')
          || (
            hasAnyRole(['si'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['contractSupervisor'])
            && [
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['shiftSupervisor'])
            && [
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            hasAnyRole(['operations'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
        );
    }

    function directiveIssuedByRequester(data) {
      return data.get('createdByUid', '') == request.auth.uid
        || data.get('issuedByUid', '') == request.auth.uid;
