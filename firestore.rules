    function templateVersionIdentityUnchanged() {
      return request.resource.data.firestoreId == resource.data.firestoreId
        && request.resource.data.packageFirestoreId == resource.data.packageFirestoreId
        && request.resource.data.versionNumber == resource.data.versionNumber
        && request.resource.data.get('sourceVersionFirestoreId', null) == resource.data.get('sourceVersionFirestoreId', null)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isDeleted == resource.data.isDeleted;
