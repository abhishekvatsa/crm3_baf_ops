rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 🔹 HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function globalPullStampAbsentOnCreate() {
      return !request.resource.data.keys().hasAny([
        '_globalPullServerUpdatedAt'
      ]);
    }

    function globalPullStampValidOnUpdate() {
      let requestHasStamp = request.resource.data.keys().hasAny([
        '_globalPullServerUpdatedAt'
      ]);
      let resourceHasStamp = resource.data.keys().hasAny([
        '_globalPullServerUpdatedAt'
      ]);
      return (
          requestHasStamp
          && resourceHasStamp
          && request.resource.data.get('_globalPullServerUpdatedAt', null)
            == resource.data.get('_globalPullServerUpdatedAt', null)
        )
        || (
          // Legacy clients can replace a document instead of merging it. An
          // omitted stamp is safe only when business data also changed, which
          // causes the retrying server trigger to write a fresh stamp.
          !requestHasStamp
          && (
            !resourceHasStamp
            || !request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              '_globalPullServerUpdatedAt'
            ])
          )
        );
    }

    function targetTombstoneHasDeletionAuthority() {
      return request.resource.data.get('isDeleted', false) == false
        || request.resource.data.get('deletedAt', null) is string;
    }

    function isPersistedTimestamp(value) {
      return value is timestamp || value is string;
    }

    function isOptionalPersistedTimestamp(value) {
      return value == null || isPersistedTimestamp(value);
    }

    function isFiveDigitChargeNumber(value) {
      return value is int && value >= 10000 && value <= 99999;
    }

    function hasUserDoc() {
      return isSignedIn()
        ? exists(/databases/$(database)/documents/users/$(request.auth.uid))
        : false;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function validUserRoleList(roles) {
      return roles is list
        && roles.size() > 0
        && roles.size() <= 10
        && roles.hasOnly([
          'admin',
          'si',
          'contractSupervisor',
          'shiftSupervisor',
          'seniorElectrical',
          'seniorMechanical',
          'seniorInstrumentation',
          'seniorRefractory',
          'refractory',
          'operations'
        ]);
    }

    function validOptionalUserString(value, maxLength) {
      return value == null
        || (value is string && value.size() <= maxLength);
    }

    function validUserDocumentShape(data) {
      return data.keys().hasAll([
          'name',
          'email',
          'roles',
          'isApproved',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'roles',
          'isApproved',
          'fcmToken',
          'createdAt'
        ])
        && data.get('name', null) is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 160
        && data.get('email', null) is string
        && data.get('email', '').size() > 0
        && data.get('email', '').size() <= 320
        && validOptionalUserString(data.get('photoUrl', null), 2048)
        && validOptionalUserString(data.get('fcmToken', null), 4096)
        && validUserRoleList(data.get('roles', null))
        && data.get('isApproved', null) is bool
        && data.get('createdAt', null) is timestamp;
    }

    // Authorization reads validate only the canonical security capsule. Full
    // user document shape remains enforced on every client create/update below.
    function validApprovedUserAuthority(data) {
      return data.keys().hasAll(['isApproved', 'roles'])
        && data.get('isApproved', false) == true
        && validUserRoleList(data.get('roles', null));
    }

    function approvedUserHasAnyRole(data, roles) {
      return validApprovedUserAuthority(data)
        && data.get('roles', []).hasAny(roles);
    }

    function isApprovedUser() {
      return hasUserDoc()
        ? validApprovedUserAuthority(userDoc().data)
        : false;
    }

    function hasAnyRole(roles) {
      return hasUserDoc()
        ? approvedUserHasAnyRole(userDoc().data, roles)
        : false;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isAdminOrSI() {
      return hasAnyRole(['admin', 'si']);
    }

    function isJobExecutionAssigner() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'seniorMechanical',
        'seniorElectrical',
        'seniorInstrumentation',
        'seniorRefractory'
      ]);
    }

    function canCreateJobDiaryEntry() {
      return isJobExecutionAssigner();
    }

    function canCloseMaintenanceTicket() {
      return isJobExecutionAssigner();
    }

    function canReopenMaintenanceTicket() {
      return hasAnyRole(['admin', 'si', 'operations']);
    }

    function canLogChargeAbnormality() {
      return hasAnyRole([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor',
        'operations'
      ]);
    }

    function isSelf(userId) {
      return isSignedIn()
        ? request.auth.uid == userId
        : false;
    }

    function hasVerifiedTokenEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function requestEmailMatchesToken() {
      return hasVerifiedTokenEmail()
        && request.resource.data.email == request.auth.token.email;
    }

    function validPendingUserCreate(userId) {
      return isSelf(userId)
        && requestEmailMatchesToken()
        && validUserDocumentShape(request.resource.data)
        && request.resource.data.get('roles', []).hasAll(['operations'])
        && request.resource.data.get('roles', []).hasOnly(['operations'])
        && request.resource.data.get('isApproved', null) == false;
    }

    function validSelfUserUpdate(userId) {
      return isSelf(userId)
        && requestEmailMatchesToken()
        && validUserDocumentShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'fcmToken'
        ])
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('isApproved', null) == resource.data.get('isApproved', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function validAdminUserProfileUpdate(userId) {
      return isAdmin()
        && validUserDocumentShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'fcmToken'
        ])
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('isApproved', null) == resource.data.get('isApproved', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function validNotificationInstallation(data, installationId) {
      return installationId.matches(
          '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
        )
        && data.keys().hasAll([
          'schemaVersion',
          'token',
          'platform',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'token',
          'platform',
          'updatedAt'
        ])
        && data.get('schemaVersion', 0) == 1
        && data.get('token', null) is string
        && data.get('token', '').size() > 0
        && data.get('token', '').size() <= 4096
        && data.get('platform', '') in [
          'android',
          'ios',
          'macos',
          'windows',
          'linux',
          'fuchsia',
          'web'
        ]
        && data.get('updatedAt', null) is timestamp;
    }

    function canWriteOwnNotificationInstallation(userId) {
      return isSelf(userId) && hasUserDoc()
        ? validUserDocumentShape(userDoc().data)
        : false;
    }

    function validNotificationInstallationWrite(userId, installationId) {
      return canWriteOwnNotificationInstallation(userId)
        && validNotificationInstallation(
          request.resource.data,
          installationId
        )
        && request.resource.data.get('updatedAt', null) == request.time;
    }

    // ─────────────────────────────────────────────
    // 🔀 MAINTENANCE WORKFLOW CONTROL-PLANE HELPERS
    // ─────────────────────────────────────────────

    function workflowServerOwnedExecutionFieldsUnchanged() {
      return request.resource.data.get('workflowSchemaVersion', 0) == resource.data.get('workflowSchemaVersion', 0)
        && request.resource.data.get('laneSetVersion', 0) == resource.data.get('laneSetVersion', 0)
        && request.resource.data.get('laneSetFinalizedAt', null) == resource.data.get('laneSetFinalizedAt', null)
        && request.resource.data.get('laneSetFinalizedByUid', null) == resource.data.get('laneSetFinalizedByUid', null)
        && request.resource.data.get('laneSetFinalizedByName', null) == resource.data.get('laneSetFinalizedByName', null)
        && request.resource.data.get('laneMappingReview', false) == resource.data.get('laneMappingReview', false)
        && request.resource.data.get('parentExecutionFirestoreId', null) == resource.data.get('parentExecutionFirestoreId', null)
        && request.resource.data.get('spawnedRedExecutionFirestoreId', null) == resource.data.get('spawnedRedExecutionFirestoreId', null)
        && request.resource.data.get('redAnswerJson', null) == resource.data.get('redAnswerJson', null)
        && request.resource.data.get('isCancelled', false) == resource.data.get('isCancelled', false)
        && request.resource.data.get('cancelledAt', null) == resource.data.get('cancelledAt', null)
        && request.resource.data.get('cancelledByUid', null) == resource.data.get('cancelledByUid', null)
        && request.resource.data.get('cancelledByName', null) == resource.data.get('cancelledByName', null)
        && request.resource.data.get('cancellationReason', null) == resource.data.get('cancellationReason', null);
    }

    function validWorkflowExecutionCreateDefaults() {
      return request.resource.data.get('workflowSchemaVersion', 0) == 0
        && request.resource.data.get('laneSetVersion', 0) == 0
        && request.resource.data.get('laneSetFinalizedAt', null) == null
        && request.resource.data.get('laneSetFinalizedByUid', null) == null
        && request.resource.data.get('laneSetFinalizedByName', null) == null
        && request.resource.data.get('laneMappingReview', false) == false
        && request.resource.data.get('parentExecutionFirestoreId', null) == null
        && request.resource.data.get('spawnedRedExecutionFirestoreId', null) == null
        && request.resource.data.get('redAnswerJson', null) == null
        && request.resource.data.get('isCancelled', false) == false
        && request.resource.data.get('cancelledAt', null) == null
        && request.resource.data.get('cancelledByUid', null) == null
        && request.resource.data.get('cancelledByName', null) == null
        && request.resource.data.get('cancellationReason', null) == null;
    }

    // ─────────────────────────────────────────────
    // 🧩 LEGACY JOB TEMPLATE HELPERS
    // ─────────────────────────────────────────────

    function validLegacyJobTemplateCreate() {
      return isAdminOrSI()
        && request.resource.data.get('isDeleted', false) == false;
    }

    function validLegacyJobTemplateUpdate() {
      return targetTombstoneHasDeletionAuthority()
        && (
          (
            isAdminOrSI()
            && request.resource.data.get('isDeleted', false) ==
              resource.data.get('isDeleted', false)
          )
          || (
            isAdmin()
            && resource.data.get('isDeleted', false) == false
            && request.resource.data.get('isDeleted', false) == true
          )
        );
    }

    // ─────────────────────────────────────────────
    // ⚙️ JOB EXECUTION HELPERS
    // ─────────────────────────────────────────────

    function jobExecutionAllowedFields() {
      return [
        'firestoreId',
        'templateFirestoreId',
        'templateName',
        'templatePackageId',
        'templateVersionId',
        'templateVersionNumber',
        'templateVersionLabel',
        'templateContentHash',
        'templatePackageCode',
        'assetType',
        'assetNumber',
        'isCompleted',
        'isCancelled',
        'cancelledAt',
        'cancelledByUid',
        'cancelledByName',
        'cancellationReason',
        'assignedByUid',
        'assignedByName',
        'assignedAgencies',
        'workflowSchemaVersion',
        'laneSetVersion',
        'laneSetFinalizedAt',
        'laneSetFinalizedByUid',
        'laneSetFinalizedByName',
        'laneMappingReview',
        'parentExecutionFirestoreId',
        'spawnedRedExecutionFirestoreId',
        'redAnswerJson',
        'completedByUid',
        'completedByName',
        'remarks',
        'teamsInvolved',
        'chargeNoAtEvent',
        'responsesJson',
        'actionsJson',
        'version',
        'metadataJson',
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'createdAt',
        'completedAt',
        'updatedAt'
      ];
    }

    function referencesExistingTemplateVersion(templateSourceId) {
      return templateSourceId is string
        && templateSourceId.size() > 0
        && exists(
          /databases/$(database)/documents/template_versions/$(templateSourceId)
        );
    }

    function validJobExecutionCreate(docId) {
      return request.resource.data.keys().hasAll([
          'firestoreId',
          'templateFirestoreId',
          'assetType',
          'assetNumber',
          'assignedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isCompleted',
          'isDeleted'
        ])
        ? (isJobExecutionAssigner()
          && request.resource.data.keys().hasOnly(jobExecutionAllowedFields())
          && request.resource.data.get('firestoreId', null) == docId
          && request.resource.data.get('templateFirestoreId', null) is string
          && request.resource.data.get('assetType', null) is string
          && request.resource.data.get('assetNumber', -1) is int
          && request.resource.data.get('assignedByUid', null) is string
          && request.resource.data.get('assignedByUid', null) == request.auth.uid
          && validWorkflowExecutionCreateDefaults()
          // Governed TemplatePackage/TemplateVersion assignment is created only
          // by assignPublishedTemplateVersion through the Admin SDK.
          && request.resource.data.get('templatePackageId', null) == null
          && request.resource.data.get('templateVersionId', null) == null
          && request.resource.data.get('templateContentHash', null) == null
          && !referencesExistingTemplateVersion(
            request.resource.data.get('templateFirestoreId', '')
          )
          && request.resource.data.get('createdAt', null) is string
          && request.resource.data.get('updatedAt', null) is string
          && request.resource.data.get('version', -1) is int
          && request.resource.data.get('version', -1) >= 1
          && request.resource.data.get('isCompleted', false) == false
          && request.resource.data.get('isDeleted', false) == false)
        : false;
    }

    function validJobExecutionBaseUpdate(docId) {
      return workflowServerOwnedExecutionFieldsUnchanged()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.get('templateFirestoreId', null) == resource.data.get('templateFirestoreId', null)
        && request.resource.data.get('templatePackageId', null) == resource.data.get('templatePackageId', null)
        && request.resource.data.get('templateVersionId', null) == resource.data.get('templateVersionId', null)
        && request.resource.data.get('templateVersionNumber', null) == resource.data.get('templateVersionNumber', null)
        && request.resource.data.get('templateContentHash', null) == resource.data.get('templateContentHash', null)
        && request.resource.data.get('assetNumber', -1) == resource.data.get('assetNumber', -1)
        && request.resource.data.get('assetType', null) == resource.data.get('assetType', null)
        && request.resource.data.get('assignedByUid', null) == resource.data.get('assignedByUid', null)
        && request.resource.data.get('assignedByName', null) == resource.data.get('assignedByName', null)
        && request.resource.data.get('assignedAgencies', []) == resource.data.get('assignedAgencies', [])
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function jobExecutionWorkChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'remarks',
        'teamsInvolved',
        'responsesJson',
        'actionsJson',
        'metadataJson',
        'updatedAt',
        'version'
      ]);
    }

    function validJobExecutionWorkUpdate() {
      return resource.data.get('isCompleted', null) == false
        && request.resource.data.get('isCompleted', null) == false
        && resource.data.get('isCancelled', false) == false
        && request.resource.data.get('isCancelled', false) == false
        && jobExecutionWorkChangedFieldsOnly();
    }

    function validJobExecutionUpdate(docId) {
      return request.resource.data.get('isCompleted', false) !=
          resource.data.get('isCompleted', false)
        ? false
        : (isJobExecutionAssigner()
          && validJobExecutionBaseUpdate(docId)
          && validJobExecutionWorkUpdate());
    }

    // ─────────────────────────────────────────────
    // 🧱 JOB MODULE HELPERS
    // ─────────────────────────────────────────────

    // BEGIN GENERATED WORKFLOW MODULE AUTHORITY
    // Source: governance/maintenance_workflow_policy_v1.json
    function rolesCanSaveJobModuleWork(roles, discipline) {
      return (discipline == 'electrical' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'seniorElectrical']))
          || (discipline == 'mechanical' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'seniorMechanical']))
          || (discipline in ['instrumentation', 'instrument', 'ia', 'iAndA', 'instrumentationAndAutomation', 'instrumentationAutomation'] && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'seniorInstrumentation']))
          || (discipline == 'operations' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'operations']))
          || (discipline == 'shiftInCharge' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor']))
          || (discipline == 'emd' && roles.hasAny(['admin', 'si']))
          || (discipline == 'refractory' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'refractory', 'seniorRefractory']))
          || (discipline == 'safety' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor']))
          || (discipline == 'admin' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor']))
          || (discipline == 'shared' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor']))
          || (discipline == 'others' && roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor', 'seniorRefractory']));
    }

    function rolesAreModuleLifecycleModerator(roles) {
      return roles.hasAny(['admin', 'si', 'contractSupervisor', 'shiftSupervisor']);
    }

    function rolesCanSubmitJobModuleDiscipline(roles, discipline) {
      return rolesCanSaveJobModuleWork(roles, discipline);
    }
    // END GENERATED WORKFLOW MODULE AUTHORITY

    function jobModuleParentExistsAndIsOpen() {
      let executionId = resource.data.get('jobExecutionFirestoreId', '');
      return executionId is string
        && executionId.size() > 0
        && exists(/databases/$(database)/documents/job_executions/$(executionId))
        && get(
          /databases/$(database)/documents/job_executions/$(executionId)
        ).data.get('isDeleted', false) == false
        && get(
          /databases/$(database)/documents/job_executions/$(executionId)
        ).data.get('isCompleted', false) == false
        && get(
          /databases/$(database)/documents/job_executions/$(executionId)
        ).data.get('isCancelled', false) == false;
    }

    function jobModuleLaneAllowsWork() {
      let executionId = resource.data.get('jobExecutionFirestoreId', '');
      let laneDocId = resource.data.get('workflowLaneFirestoreId', '');
      return executionId is string
        && executionId.size() > 0
        && exists(/databases/$(database)/documents/job_executions/$(executionId))
        && (
          get(/databases/$(database)/documents/job_executions/$(executionId)).data.get('workflowSchemaVersion', 0) != 1
          || (
            laneDocId is string
            && laneDocId.size() > 0
            && exists(/databases/$(database)/documents/job_lanes/$(laneDocId))
            && get(/databases/$(database)/documents/job_lanes/$(laneDocId)).data.get('jobExecutionId', '') == executionId
            && get(/databases/$(database)/documents/job_lanes/$(laneDocId)).data.get('status', '') == 'acknowledged'
          )
        );
    }

    function validJobModuleUpdateCommon(docId, changedKeys) {
      return !changedKeys.hasAny([
          'firestoreId',
          'jobExecutionFirestoreId',
          'createdByUid',
          'createdByName',
          'createdAt',
          'addedByUid',
          'addedByName',
          'addedAt',
          'addReason',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'assetType',
          'assetNumber',
          'chargeNoAtEvent',
          'discipline',
          'laneKey',
          'laneActivationGeneration',
          'workflowLaneFirestoreId',
          'isRequired',
          'requiredForClosure',
          'addedDuringExecution',
          'templateFirestoreId',
          'templatePackageId',
          'templateVersionId',
          'templateModuleId',
          'responses',
          'isSynced',
          'populationCreateFingerprint',
          'populationAcceptedAt',
          'populationAcceptedByUid',
          'populationMutationSchemaVersion',
          'populationPreservationReason',
          'populationOriginalActorClaims',
          'parentPopulationVersionAtAcceptance',
          'populationSoftDeleteFingerprint',
          'populationDeletedAt',
          'populationDeletedByUid',
          'parentPopulationVersionAtMutation'
        ])
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == false
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function isOpenModuleStatus(status) {
      return status == 'notStarted'
        || status == 'draftSaved'
        || status == 'inProgress'
        || status == 'reopened';
    }

    function jobModuleChangedFieldsOnly(changedKeys, allowedFields) {
      return changedKeys.hasOnly(allowedFields);
    }

    function jobModuleCoreWorkChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'isOpenForWork',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleSubmitChangedFieldsOnly(changedKeys) {
      // Offline-first tablets can save work and submit before a push occurs,
      // so submit allows the normal mutable work fields plus submit lifecycle fields.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'isOpenForWork',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'submittedByUid',
        'submittedByName',
        'submittedAt',
        'submissionNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleAcceptChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'isOpenForWork',
        'acceptedByUid',
        'acceptedByName',
        'acceptedAt',
        'acceptanceNote',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleReopenChangedFieldsOnly(changedKeys) {
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'isOpenForWork',
        'reopenedByUid',
        'reopenedByName',
        'reopenedAt',
        'reopenReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function jobModuleNotApplicableChangedFieldsOnly(changedKeys) {
      // A tablet may save normal work fields and mark a module not applicable
      // before the next push, so allow the core mutable work fields too.
      return jobModuleChangedFieldsOnly(changedKeys, [
        'status',
        'isOpenForWork',
        'responsesJson',
        'actionsJson',
        'draftNote',
        'pendingIssue',
        'requiresFollowUp',
        'notApplicableByUid',
        'notApplicableByName',
        'notApplicableAt',
        'notApplicableReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version',
        'metadataJson'
      ]);
    }

    function validJobModuleWorkUpdate(changedKeys, roles) {
      return isOpenModuleStatus(request.resource.data.get('status', null))
        && request.resource.data.get('isOpenForWork', null) == true
        && jobModuleLaneAllowsWork()
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleCoreWorkChangedFieldsOnly(changedKeys)
        && request.resource.data.get('updatedByUid', null) is string
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && rolesCanSaveJobModuleWork(roles, resource.data.get('discipline', null));
    }

    function validJobModuleSubmit(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'submitted'
        && request.resource.data.get('isOpenForWork', null) == false
        && jobModuleLaneAllowsWork()
        && isOpenModuleStatus(resource.data.get('status', null))
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleSubmitChangedFieldsOnly(changedKeys)
        && request.resource.data.get('submittedByUid', null) == request.auth.uid
        && rolesCanSubmitJobModuleDiscipline(roles, resource.data.get('discipline', null));
    }

    function validJobModuleAccept(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'accepted'
        && request.resource.data.get('isOpenForWork', null) == false
        && jobModuleLaneAllowsWork()
        && resource.data.get('status', null) == 'submitted'
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleAcceptChangedFieldsOnly(changedKeys)
        && request.resource.data.get('acceptedByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleReopen(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'reopened'
        && request.resource.data.get('isOpenForWork', null) == true
        && jobModuleLaneAllowsWork()
        && (
          resource.data.get('status', null) == 'submitted'
          || resource.data.get('status', null) == 'accepted'
          || resource.data.get('status', null) == 'notApplicable'
        )
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleReopenChangedFieldsOnly(changedKeys)
        && request.resource.data.get('reopenedByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleNotApplicable(changedKeys, roles) {
      return request.resource.data.get('status', null) == 'notApplicable'
        && request.resource.data.get('isOpenForWork', null) == false
        && jobModuleLaneAllowsWork()
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && jobModuleNotApplicableChangedFieldsOnly(changedKeys)
        && request.resource.data.get('notApplicableByUid', null) == request.auth.uid
        && rolesAreModuleLifecycleModerator(roles);
    }

    function validJobModuleSoftDelete(changedKeys, roles) {
      // Population-removing soft deletes must use the same server-governed
      // parent fence as module creation. Direct client tombstones are denied.
      return false;
    }

    function validJobModuleUpdatePayload(docId, changedKeys, roles) {
      let targetStatus = request.resource.data.get('status', null);
      return jobModuleParentExistsAndIsOpen()
        && validJobModuleUpdateCommon(docId, changedKeys)
        && (request.resource.data.get('isDeleted', false) !=
            resource.data.get('isDeleted', false)
          ? validJobModuleSoftDelete(changedKeys, roles)
          : (targetStatus == 'submitted'
            ? validJobModuleSubmit(changedKeys, roles)
            : (targetStatus == 'accepted'
              ? validJobModuleAccept(changedKeys, roles)
              : (targetStatus == 'reopened'
                ? validJobModuleReopen(changedKeys, roles)
                : (targetStatus == 'notApplicable'
                  ? validJobModuleNotApplicable(changedKeys, roles)
                  : (isOpenModuleStatus(targetStatus)
                    ? validJobModuleWorkUpdate(changedKeys, roles)
                    : false))))));
    }

    function validJobModuleUpdate(docId) {
      // Fast-deny local-only/legacy fields before any document lookup. Then
      // validate the canonical authority capsule once, snapshot its roles,
      // and evaluate only the transition selected by the target status.
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['responses', 'isSynced'])
        ? false
        : (hasUserDoc()
          ? (validApprovedUserAuthority(userDoc().data)
            ? validJobModuleUpdatePayload(
                docId,
                changedKeys,
                userDoc().data.get('roles', [])
              )
            : false)
          : false);
    }

    // ─────────────────────────────────────────────
    // 📝 JOB DIARY HELPERS
    // ─────────────────────────────────────────────

    function validJobDiaryCreate(docId) {
      return canCreateJobDiaryEntry()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'note',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('note', null) is string
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false;
    }

    function validJobDiaryUpdate(docId) {
      // Diary notes remain editable by their creator and by Admin/SI.
      // Version must strictly advance and hard/soft delete is not allowed here.
      return isApprovedUser()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note',
          'updatedByUid',
          'updatedByName',
          'updatedAt',
          'version'
        ])
        && request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1)
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && request.resource.data.get('isDeleted', false) == false
        && (
          isAdminOrSI()
          || resource.data.get('createdByUid', null) == request.auth.uid
        );
    }

    // ─────────────────────────────────────────────
    // 📢 DIRECTIVE HELPERS
    // ─────────────────────────────────────────────

    function directiveRolesCanCloseAny(roles) {
      return roles.hasAny([
        'admin',
        'si',
        'contractSupervisor',
        'shiftSupervisor'
      ]);
    }

    function directiveRolesCanTarget(roles, role) {
      return role is string
        && (
          (roles.hasAny(['admin']) && role != 'admin')
          || (
            roles.hasAny(['si'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            roles.hasAny(['contractSupervisor'])
            && [
              'shiftSupervisor',
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            roles.hasAny(['shiftSupervisor'])
            && [
              'operations',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
          || (
            roles.hasAny(['operations'])
            && [
              'contractSupervisor',
              'shiftSupervisor',
              'seniorElectrical',
              'seniorMechanical',
              'seniorInstrumentation',
              'seniorRefractory'
            ].hasAny([role])
          )
        );
    }

    function directiveIssuedByRequester(data) {
      return data.get('createdByUid', '') == request.auth.uid
        || data.get('issuedByUid', '') == request.auth.uid;
    }

    function directiveAllowedFields() {
      return [
        'firestoreId',
        'title',
        'description',
        'assetType',
        'assetNumber',
        'component',
        'subsystem',
        'tag',
        'hierarchyPath',
        'directedTo',
        'status',
        'priority',
        'createdByUid',
        'createdByName',
        'issuedByUid',
        'issuedByName',
        'issuedAt',
        'isActive',
        'acknowledgedByUid',
        'acknowledgedByName',
        'acknowledgedAt',
        'closedByUid',
        'closedByName',
        'closedAt',
        'closedWithoutAcknowledgement',
        'remarks',
        'linkedMaintenanceFirestoreId',
        'linkedExecutionFirestoreId',
        'metadataJson',
        'isDeleted',
        'deletedAt',
        'deletedByUid',
        'deletedByName',
        'deleteReason',
        'createdAt',
        'updatedAt',
        'version'
      ];
    }

    function validDirectiveCreateForRoles(docId, roles) {
      return request.resource.data.keys().hasAll([
          'firestoreId',
          'title',
          'description',
          'directedTo',
          'status',
          'createdByUid',
          'issuedByUid',
          'createdAt',
          'updatedAt',
          'version',
          'isDeleted'
        ])
        ? (request.resource.data.keys().hasOnly(directiveAllowedFields())
          && request.resource.data.get('firestoreId', null) is string
          && request.resource.data.get('firestoreId', null) == docId
          && request.resource.data.get('isDeleted', false) == false
          && request.resource.data.get('status', null) == 'open'
          && request.resource.data.get('title', null) is string
          && request.resource.data.get('description', null) is string
          && request.resource.data.get('directedTo', null) is string
          && request.resource.data.get('createdByUid', null) is string
          && request.resource.data.get('createdByUid', null) == request.auth.uid
          && request.resource.data.get('issuedByUid', null) is string
          && request.resource.data.get('issuedByUid', null) == request.auth.uid
          && request.resource.data.get('createdAt', null) is string
          && request.resource.data.get('updatedAt', null) is string
          && request.resource.data.get('version', -1) is int
          && request.resource.data.get('version', -1) >= 1
          && directiveRolesCanTarget(
            roles,
            request.resource.data.get('directedTo', null)
          ))
        : false;
    }

    function validBurnerRedHotDirectiveCreate(docId) {
      let sourceId = request.resource.data.get(
        'linkedMaintenanceFirestoreId',
        null
      );
      return sourceId is string
        && request.resource.data.keys().hasOnly(directiveAllowedFields())
        && existsAfter(
          /databases/$(database)/documents/maintenance_records/$(sourceId)
        )
        && validBurnerRedHotDirectiveProjection(
          request.resource.data,
          getAfter(
            /databases/$(database)/documents/maintenance_records/$(sourceId)
          ).data,
          docId,
          sourceId
        );
    }

    function validDirectiveCreate(docId) {
      return hasUserDoc()
        ? (validApprovedUserAuthority(userDoc().data)
          ? (validBurnerRedHotDirectiveCreate(docId)
            || validDirectiveCreateForRoles(
              docId,
              userDoc().data.get('roles', [])
            ))
          : false)
        : false;
    }

    function validDirectiveBaseUpdate() {
      return resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == false
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('issuedByUid', null) == resource.data.get('issuedByUid', null)
        && request.resource.data.get('directedTo', null) == resource.data.get('directedTo', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function validDirectiveAcknowledgeForRoles(roles) {
      return validDirectiveBaseUpdate()
        && resource.data.get('status', null) == 'open'
        && request.resource.data.get('status', null) == 'acknowledged'
        && request.resource.data.get('acknowledgedByUid', null) == request.auth.uid
        && request.resource.data.get('acknowledgedAt', null) != null
        && resource.data.get('directedTo', null) is string
        && roles.hasAny([resource.data.get('directedTo', null)])
        && request.resource.data.get('closedByUid', null) == null
        && request.resource.data.get('closedAt', null) == null;
    }

    function validDirectiveCloseForRoles(roles) {
      return validDirectiveBaseUpdate()
        && (resource.data.get('status', null) == 'open' || resource.data.get('status', null) == 'acknowledged')
        && request.resource.data.get('status', null) == 'closed'
        && request.resource.data.get('closedByUid', null) == request.auth.uid
        && request.resource.data.get('closedAt', null) != null
        && (
          directiveRolesCanCloseAny(roles)
          || directiveIssuedByRequester(resource.data)
          || (
            resource.data.get('status', null) == 'acknowledged'
            && resource.data.get('acknowledgedByUid', null) == request.auth.uid
            && resource.data.get('directedTo', null) is string
            && roles.hasAny([resource.data.get('directedTo', null)])
          )
        );
    }

    function validDirectiveAdminEditForRoles(roles) {
      return roles.hasAny(['admin'])
        && request.resource.data.get('isDeleted', false) ==
          resource.data.get('isDeleted', false)
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1);
    }

    function validDirectiveAdminDeleteForRoles(roles) {
      return roles.hasAny(['admin'])
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == true
        && request.resource.data.get('deletedByUid', '') == request.auth.uid;
    }

    function validDirectiveUpdateForRoles(roles) {
      return roles.hasAny(['admin'])
        ? (request.resource.data.get('isDeleted', false) == true
          && resource.data.get('isDeleted', false) == false
          ? validDirectiveAdminDeleteForRoles(roles)
          : validDirectiveAdminEditForRoles(roles))
        : (request.resource.data.get('status', null) == 'acknowledged'
          ? validDirectiveAcknowledgeForRoles(roles)
          : (request.resource.data.get('status', null) == 'closed'
            ? validDirectiveCloseForRoles(roles)
            : false));
    }

    function validDirectiveUpdate() {
      return targetTombstoneHasDeletionAuthority()
        && hasUserDoc()
        ? (validApprovedUserAuthority(userDoc().data)
          ? validDirectiveUpdateForRoles(userDoc().data.get('roles', []))
          : false)
        : false;
    }

    // ─────────────────────────────────────────────
    // 🧬 TEMPLATE GOVERNANCE HELPERS
    // ─────────────────────────────────────────────

    function isTemplateGovernor() {
      return isAdminOrSI();
    }

    function isPackageLifecycleStatus(status) {
      return status == 'active'
        || status == 'retired'
        || status == 'archived';
    }

    function isTemplateAuditAction(action) {
      return action == 'created'
        || action == 'edited'
        || action == 'published'
        || action == 'retired'
        || action == 'restored'
        || action == 'archived';
    }

    function validTemplatePackageCreate(docId) {
      return isTemplateGovernor()
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('packageCode', null) is string
        && request.resource.data.get('title', null) is string
        && request.resource.data.get('lifecycleStatus', null) == 'active'
        && request.resource.data.get('latestVersionNumber', -1) is int
        && request.resource.data.get('latestVersionNumber', -1) >= 0
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('schemaVersion', -1) is int
        && request.resource.data.get('isDeleted', null) == false
        && validTemplatePackageTimeline();
    }

    function validTemplatePackageTimeline() {
      let status = request.resource.data.get('lifecycleStatus', null);
      let retiredAt = request.resource.data.get('retiredAt', null);
      return isPersistedTimestamp(
          request.resource.data.get('createdAt', null)
        )
        && isPersistedTimestamp(
          request.resource.data.get('updatedAt', null)
        )
        && isOptionalPersistedTimestamp(retiredAt)
        && (status != 'retired' || isPersistedTimestamp(retiredAt));
    }

    function validTemplatePackageActivePointer(docId) {
      let activeVersionId =
        request.resource.data.get('activeVersionFirestoreId', null);
      return activeVersionId == null
        || (
          activeVersionId is string
          && existsAfter(
            /databases/$(database)/documents/template_versions/$(activeVersionId)
          )
          && getAfter(
            /databases/$(database)/documents/template_versions/$(activeVersionId)
          ).data.get('firestoreId', null) == activeVersionId
          && getAfter(
            /databases/$(database)/documents/template_versions/$(activeVersionId)
          ).data.get('packageFirestoreId', null) == docId
          && getAfter(
            /databases/$(database)/documents/template_versions/$(activeVersionId)
          ).data.get('status', null) == 'published'
          && getAfter(
            /databases/$(database)/documents/template_versions/$(activeVersionId)
          ).data.get('isDeleted', false) == false
          && request.resource.data.get('latestVersionNumber', -1) ==
            getAfter(
              /databases/$(database)/documents/template_versions/$(activeVersionId)
            ).data.get('versionNumber', -2)
        );
    }

    function validTemplatePackageUpdate(docId) {
      return isTemplateGovernor()
        && resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('isDeleted', null) == resource.data.get('isDeleted', null)
        && isPackageLifecycleStatus(request.resource.data.get('lifecycleStatus', null))
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1)
        && validTemplatePackageTimeline()
        && validTemplatePackageActivePointer(docId);
    }

    function validTemplateVersionTimeline() {
      let status = request.resource.data.get('status', null);
      let publishedAt = request.resource.data.get('publishedAt', null);
      let retiredAt = request.resource.data.get('retiredAt', null);
      let closureConfirmed = request.resource.data.get(
        'closureReviewConfirmed',
        false
      );
      return isPersistedTimestamp(
          request.resource.data.get('createdAt', null)
        )
        && isPersistedTimestamp(
          request.resource.data.get('updatedAt', null)
        )
        && isOptionalPersistedTimestamp(
          request.resource.data.get('closureReviewConfirmedAt', null)
        )
        && isOptionalPersistedTimestamp(publishedAt)
        && isOptionalPersistedTimestamp(retiredAt)
        && closureConfirmed is bool
        && (
          closureConfirmed != true
          || isPersistedTimestamp(
            request.resource.data.get('closureReviewConfirmedAt', null)
          )
        )
        && (
          status == 'draft'
            ? (publishedAt == null && retiredAt == null)
            : (status == 'published'
              ? (isPersistedTimestamp(publishedAt) && retiredAt == null)
              : (status == 'retired'
                ? (
                  isPersistedTimestamp(publishedAt)
                  && isPersistedTimestamp(retiredAt)
                )
                : (status == 'archived'
                  && (
                    (publishedAt == null && retiredAt == null)
                    || (
                      isPersistedTimestamp(publishedAt)
                      && isPersistedTimestamp(retiredAt)
                    )
                  ))))
        );
    }

    function validTemplateVersionCreate(docId) {
      return request.resource.data.keys().hasAll([
          'firestoreId',
          'packageFirestoreId',
          'versionNumber',
          'status',
          'jobTemplateSnapshotJson',
          'moduleSnapshotsJson',
          'fieldDefinitionsJson',
          'checklistJson',
          'createdByUid',
          'updatedByUid',
          'version',
          'schemaVersion',
          'isDeleted'
        ])
        ? (isTemplateGovernor()
          && request.resource.data.get('firestoreId', null) == docId
          && request.resource.data.get('packageFirestoreId', null) is string
          && request.resource.data.get('versionNumber', -1) is int
          && request.resource.data.get('versionNumber', -1) >= 1
          && request.resource.data.get('status', null) == 'draft'
          && request.resource.data.get('jobTemplateSnapshotJson', null) is string
          && request.resource.data.get('moduleSnapshotsJson', null) is string
          && request.resource.data.get('fieldDefinitionsJson', null) is string
          && request.resource.data.get('checklistJson', null) is string
          && request.resource.data.get('createdByUid', null) == request.auth.uid
          && request.resource.data.get('updatedByUid', null) == request.auth.uid
          && request.resource.data.get('version', -1) is int
          && request.resource.data.get('version', -1) >= 1
          && request.resource.data.get('schemaVersion', -1) is int
          && request.resource.data.get('isDeleted', null) == false
          && validTemplateVersionTimeline())
        : false;
    }

    function templateVersionIdentityUnchanged() {
      return request.resource.data.get('firestoreId', null) == resource.data.get('firestoreId', null)
        && request.resource.data.get('packageFirestoreId', null) == resource.data.get('packageFirestoreId', null)
        && request.resource.data.get('versionNumber', -1) == resource.data.get('versionNumber', -1)
        && request.resource.data.get('sourceVersionFirestoreId', null) == resource.data.get('sourceVersionFirestoreId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('isDeleted', null) == resource.data.get('isDeleted', null);
    }

    function templateVersionPayloadJsonUnchanged() {
      return request.resource.data.get('jobTemplateSnapshotJson', null) == resource.data.get('jobTemplateSnapshotJson', null)
        && request.resource.data.get('moduleSnapshotsJson', null) == resource.data.get('moduleSnapshotsJson', null)
        && request.resource.data.get('fieldDefinitionsJson', null) == resource.data.get('fieldDefinitionsJson', null)
        && request.resource.data.get('checklistJson', null) == resource.data.get('checklistJson', null)
        && request.resource.data.get('targetRefs', []) == resource.data.get('targetRefs', [])
        && request.resource.data.get('deviceTagRefs', []) == resource.data.get('deviceTagRefs', [])
        && request.resource.data.get('safetyClass', null) == resource.data.get('safetyClass', null)
        && request.resource.data.get('safetyGatePolicyJson', null) == resource.data.get('safetyGatePolicyJson', null)
        && request.resource.data.get('procedureRefs', []) == resource.data.get('procedureRefs', [])
        && request.resource.data.get('operationalStatePreconditions', []) == resource.data.get('operationalStatePreconditions', []);
    }

    function templateVersionFrozenPayloadUnchanged() {
      return templateVersionPayloadJsonUnchanged()
        && request.resource.data.get('contentHash', null) == resource.data.get('contentHash', null)
        && request.resource.data.get('closureReviewConfirmed', false) == resource.data.get('closureReviewConfirmed', false)
        && request.resource.data.get('closureReviewConfirmedByUid', null) == resource.data.get('closureReviewConfirmedByUid', null)
        && request.resource.data.get('closureReviewConfirmedByName', null) == resource.data.get('closureReviewConfirmedByName', null)
        && request.resource.data.get('closureReviewConfirmedAt', null) == resource.data.get('closureReviewConfirmedAt', null)
        && request.resource.data.get('closureCriticalModuleCount', 0) == resource.data.get('closureCriticalModuleCount', 0);
    }

    function templateContentHashLooksValid() {
      return request.resource.data.get('contentHash', null) is string
        && request.resource.data.get('contentHash', null).matches('^tg2-sha256:[0-9a-f]{64}$');
    }

    function closureReviewPolicySatisfied() {
      return request.resource.data.get('closureCriticalModuleCount', 0) is int
        && (
          request.resource.data.get('closureCriticalModuleCount', 0) == 0
          || (
            request.resource.data.get('closureReviewConfirmed', false) == true
            && request.resource.data.get('closureReviewConfirmedByUid', '') == request.auth.uid
            && request.resource.data.get('closureReviewConfirmedAt', null) != null
          )
        );
    }

    function validTemplateVersionUpdateCommon(docId) {
      return isTemplateGovernor()
        && resource.data.get('firestoreId', null) == docId
        && templateVersionIdentityUnchanged()
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1)
        && validTemplateVersionTimeline();
    }

    function validDraftTemplateVersionUpdateDelta() {
      return resource.data.get('status', null) == 'draft'
        && request.resource.data.get('status', null) == 'draft';
    }

    function validTemplateVersionPublishDelta() {
      return resource.data.get('status', null) == 'draft'
        && request.resource.data.get('status', null) == 'published'
        ? (templateVersionPayloadJsonUnchanged()
          && templateContentHashLooksValid()
          && closureReviewPolicySatisfied()
          && request.resource.data.get('publishedByUid', '') == request.auth.uid
          && request.resource.data.get('publishedAt', null) != null)
        : false;
    }

    function validTemplateVersionRetireDelta() {
      return resource.data.get('status', null) == 'published'
        && request.resource.data.get('status', null) == 'retired'
        ? (templateVersionFrozenPayloadUnchanged()
          && request.resource.data.get('retiredByUid', '') == request.auth.uid
          && request.resource.data.get('retiredAt', null) != null
          && request.resource.data.get('retireReason', null) is string)
        : false;
    }

    function templateVersionHasNoPublishOrRetireHistory(data) {
      return data.get('publishedByUid', null) == null
        && data.get('publishedByName', null) == null
        && data.get('publishedAt', null) == null
        && data.get('retiredByUid', null) == null
        && data.get('retiredByName', null) == null
        && data.get('retiredAt', null) == null
        && data.get('retireReason', null) == null;
    }

    function templateVersionDraftLifecycleChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'contentHash',
        'closureReviewConfirmed',
        'closureCriticalModuleCount',
        'closureReviewConfirmedByUid',
        'closureReviewConfirmedByName',
        'closureReviewConfirmedAt',
        'updatedByUid',
        'updatedByName',
        'updatedAt',
        'version'
      ]);
    }

    function validRetiredTemplateVersionArchiveDelta() {
      return resource.data.get('status', null) == 'retired'
        && request.resource.data.get('status', null) == 'archived'
        && templateVersionFrozenPayloadUnchanged();
    }

    function validDraftTemplateVersionArchiveDelta() {
      return resource.data.get('status', null) == 'draft'
        && request.resource.data.get('status', null) == 'archived'
        && resource.data.get('isDeleted', null) == false
        && request.resource.data.get('isDeleted', null) == false
        && templateVersionHasNoPublishOrRetireHistory(resource.data)
        && templateVersionHasNoPublishOrRetireHistory(request.resource.data)
        && templateVersionPayloadJsonUnchanged()
        && templateVersionDraftLifecycleChangedFieldsOnly()
        && templateContentHashLooksValid();
    }

    function validTemplateVersionRestoreDelta() {
      return resource.data.get('status', null) == 'archived'
        && request.resource.data.get('status', null) == 'draft'
        && resource.data.get('isDeleted', null) == false
        && request.resource.data.get('isDeleted', null) == false
        && templateVersionHasNoPublishOrRetireHistory(resource.data)
        && templateVersionHasNoPublishOrRetireHistory(request.resource.data)
        && templateVersionPayloadJsonUnchanged()
        && templateVersionDraftLifecycleChangedFieldsOnly()
        && templateContentHashLooksValid();
    }

    function validTemplateVersionUpdateDelta() {
      let sourceStatus = resource.data.get('status', null);
      let targetStatus = request.resource.data.get('status', null);
      return sourceStatus == 'draft'
        ? (targetStatus == 'draft'
          ? validDraftTemplateVersionUpdateDelta()
          : (targetStatus == 'published'
            ? validTemplateVersionPublishDelta()
            : (targetStatus == 'archived'
              ? validDraftTemplateVersionArchiveDelta()
              : false)))
        : (sourceStatus == 'published'
          ? (targetStatus == 'retired'
            ? validTemplateVersionRetireDelta()
            : false)
          : (sourceStatus == 'retired'
            ? (targetStatus == 'archived'
              ? validRetiredTemplateVersionArchiveDelta()
              : false)
            : (sourceStatus == 'archived'
              ? (targetStatus == 'draft'
                ? validTemplateVersionRestoreDelta()
                : false)
              : false)));
    }

    function validTemplateVersionUpdate(docId) {
      return validTemplateVersionUpdateCommon(docId)
        && validTemplateVersionUpdateDelta();
    }

    function validTemplateLifecycleAuditEvidence() {
      return request.resource.data.get('reason', null) is string
        && request.resource.data.get('reason', '').size() >= 10
        && request.resource.data.get('afterHash', null) is string
        && request.resource.data.get('afterHash', null).matches('^tg2-sha256:[0-9a-f]{64}$')
        && request.resource.data.get('payloadSnapshotJson', null) is string;
    }

    function validPublishedTemplateAudit() {
      return request.resource.data.get('action', null) != 'published'
        || (
          existsAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          )
          && existsAfter(
            /databases/$(database)/documents/template_packages/$(request.resource.data.get('packageFirestoreId', ''))
          )
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('status', null) == 'published'
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('isDeleted', false) == false
          && request.resource.data.get('packageFirestoreId', null) ==
            getAfter(
              /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
            ).data.get('packageFirestoreId', null)
          && request.resource.data.get('afterHash', null) ==
            getAfter(
              /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
            ).data.get('contentHash', null)
          && request.resource.data.get('performedByUid', null) ==
            getAfter(
              /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
            ).data.get('publishedByUid', null)
          && getAfter(
            /databases/$(database)/documents/template_packages/$(request.resource.data.get('packageFirestoreId', ''))
          ).data.get('activeVersionFirestoreId', null) ==
            request.resource.data.get('versionFirestoreId', null)
          && getAfter(
            /databases/$(database)/documents/template_packages/$(request.resource.data.get('packageFirestoreId', ''))
          ).data.get('lifecycleStatus', null) == 'active'
          && getAfter(
            /databases/$(database)/documents/template_packages/$(request.resource.data.get('packageFirestoreId', ''))
          ).data.get('isDeleted', false) == false
        );
    }

    function validArchivedTemplateAudit() {
      return request.resource.data.get('action', null) != 'archived'
        || (
          validTemplateLifecycleAuditEvidence()
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('status', null) == 'archived'
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('isDeleted', false) == false
          && request.resource.data.get('packageFirestoreId', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('packageFirestoreId', null)
          && request.resource.data.get('afterHash', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('contentHash', null)
          && request.resource.data.get('performedByUid', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('updatedByUid', null)
        );
    }

    function validRestoredTemplateAudit() {
      return request.resource.data.get('action', null) != 'restored'
        || (
          validTemplateLifecycleAuditEvidence()
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('status', null) == 'draft'
          && getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('isDeleted', false) == false
          && request.resource.data.get('packageFirestoreId', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('packageFirestoreId', null)
          && request.resource.data.get('afterHash', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('contentHash', null)
          && request.resource.data.get('performedByUid', null) == getAfter(
            /databases/$(database)/documents/template_versions/$(request.resource.data.get('versionFirestoreId', ''))
          ).data.get('updatedByUid', null)
        );
    }

    function validTemplatePublishAuditCreate(docId) {
      return isTemplateGovernor()
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('packageFirestoreId', null) is string
        && request.resource.data.get('versionFirestoreId', null) is string
        && isTemplateAuditAction(request.resource.data.get('action', null))
        && validPublishedTemplateAudit()
        && validArchivedTemplateAudit()
        && validRestoredTemplateAudit()
        && request.resource.data.get('performedByUid', null) == request.auth.uid
        && isPersistedTimestamp(
          request.resource.data.get('performedAt', null)
        )
        && isPersistedTimestamp(
          request.resource.data.get('updatedAt', null)
        )
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false;
    }


    // ─────────────────────────────────────────────
    // 🧩 GOVERNED MODULE REGISTRY HELPERS
    // ─────────────────────────────────────────────

    function isModuleRegistryGovernor() {
      return isAdminOrSI();
    }

    function isModuleRegistryFamilyStatus(status) {
      return status == 'active' || status == 'retired';
    }

    function isModuleRegistryRevisionStatus(status) {
      return status == 'draft' || status == 'published' || status == 'retired';
    }

    function isModuleRegistryAuditAction(action) {
      return action == 'draftCreated'
        || action == 'draftUpdated'
        || action == 'revisionPublished'
        || action == 'revisionRetired'
        || action == 'familyRetired';
    }

    function moduleRegistryOptionalString(value) {
      return value == null || value is string;
    }

    function moduleRegistryContentHashLooksValid() {
      return request.resource.data.get('contentHash', null) is string
        && request.resource.data.get('contentHash', null).matches('^mrg1-sha256:[0-9a-f]{64}$');
    }

    function validModuleRegistryFamilyTimeline() {
      let status = request.resource.data.get('status', null);
      let retiredAt = request.resource.data.get('retiredAt', null);
      return isPersistedTimestamp(
          request.resource.data.get('createdAt', null)
        )
        && isPersistedTimestamp(
          request.resource.data.get('updatedAt', null)
        )
        && isOptionalPersistedTimestamp(retiredAt)
        && (
          status == 'active'
            ? retiredAt == null
            : (status == 'retired' && isPersistedTimestamp(retiredAt))
        );
    }

    function validModuleRegistryRevisionTimeline() {
      let status = request.resource.data.get('revisionStatus', null);
      let publishedAt = request.resource.data.get('publishedAt', null);
      let retiredAt = request.resource.data.get('retiredAt', null);
      return isPersistedTimestamp(
          request.resource.data.get('createdAt', null)
        )
        && isPersistedTimestamp(
          request.resource.data.get('updatedAt', null)
        )
        && isOptionalPersistedTimestamp(publishedAt)
        && isOptionalPersistedTimestamp(retiredAt)
        && (
          status == 'draft'
            ? (publishedAt == null && retiredAt == null)
            : (status == 'published'
              ? (isPersistedTimestamp(publishedAt) && retiredAt == null)
              : (status == 'retired'
                && isPersistedTimestamp(publishedAt)
                && isPersistedTimestamp(retiredAt)))
        );
    }

    function validModuleRegistryFamilyFields() {
      return request.resource.data.keys().hasAll([
          'registryModuleId',
          'moduleCode',
          'canonicalTitle',
          'status',
          'discipline',
          'ownerDisciplines',
          'assetType',
          'functionalSection',
          'componentGroup',
          'targetRefs',
          'deviceTagRefs',
          'safetyClasses',
          'requiredForClosure',
          'latestPublishedRevisionNumber',
          'createdByUid',
          'updatedByUid',
          'version',
          'schemaVersion',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'registryModuleId',
          'moduleCode',
          'canonicalTitle',
          'status',
          'discipline',
          'ownerDisciplines',
          'assetType',
          'functionalSection',
          'componentGroup',
          'targetRefs',
          'deviceTagRefs',
          'safetyClasses',
          'requiredForClosure',
          'latestPublishedRevisionNumber',
          'latestPublishedRevisionId',
          'latestPublishedContentHash',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedByUid',
          'updatedByName',
          'updatedAt',
          'retiredByUid',
          'retiredByName',
          'retiredAt',
          'retireReason',
          'version',
          'schemaVersion',
          'isDeleted'
        ])
        && request.resource.data.get('registryModuleId', null) is string
        && request.resource.data.get('moduleCode', null) is string
        && request.resource.data.get('canonicalTitle', null) is string
        && isModuleRegistryFamilyStatus(request.resource.data.get('status', null))
        && request.resource.data.get('discipline', null) is string
        && request.resource.data.get('ownerDisciplines', []) is list
        && request.resource.data.get('assetType', null) is string
        && request.resource.data.get('functionalSection', null) is string
        && request.resource.data.get('componentGroup', null) is string
        && request.resource.data.get('targetRefs', []) is list
        && request.resource.data.get('deviceTagRefs', []) is list
        && request.resource.data.get('safetyClasses', []) is list
        && request.resource.data.get('requiredForClosure', null) is bool
        && request.resource.data.get('latestPublishedRevisionNumber', null) is int
        && request.resource.data.get('latestPublishedRevisionNumber', null) >= 0
        && moduleRegistryOptionalString(request.resource.data.get('latestPublishedRevisionId', null))
        && moduleRegistryOptionalString(request.resource.data.get('latestPublishedContentHash', null))
        && (
          request.resource.data.get('latestPublishedContentHash', null) == null
          || request.resource.data.get('latestPublishedContentHash', '').matches('^mrg1-sha256:[0-9a-f]{64}$')
        )
        && request.resource.data.get('createdByUid', null) is string
        && moduleRegistryOptionalString(request.resource.data.get('createdByName', null))
        && request.resource.data.get('updatedByUid', null) is string
        && moduleRegistryOptionalString(request.resource.data.get('updatedByName', null))
        && moduleRegistryOptionalString(request.resource.data.get('retiredByUid', null))
        && moduleRegistryOptionalString(request.resource.data.get('retiredByName', null))
        && moduleRegistryOptionalString(request.resource.data.get('retireReason', null))
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('schemaVersion', -1) == 1
        && request.resource.data.get('isDeleted', null) == false
        && validModuleRegistryFamilyTimeline();
    }

    function validModuleRegistryFamilyCreate(docId) {
      return isModuleRegistryGovernor()
        && validModuleRegistryFamilyFields()
        && request.resource.data.get('registryModuleId', null) == docId
        && request.resource.data.get('status', null) == 'active'
        && request.resource.data.get('latestPublishedRevisionNumber', null) == 0
        && request.resource.data.get('latestPublishedRevisionId', null) == null
        && request.resource.data.get('latestPublishedContentHash', null) == null
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid;
    }

    function moduleRegistryFamilyIdentityUnchanged() {
      return request.resource.data.get('registryModuleId', null) == resource.data.get('registryModuleId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdByName', null) == resource.data.get('createdByName', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('schemaVersion', -1) == resource.data.get('schemaVersion', -1)
        && request.resource.data.get('isDeleted', null) == resource.data.get('isDeleted', null);
    }
    function moduleRegistryFamilyPublishChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'moduleCode',
        'canonicalTitle',
        'discipline',
        'ownerDisciplines',
        'assetType',
        'functionalSection',
        'componentGroup',
        'targetRefs',
        'deviceTagRefs',
        'safetyClasses',
        'requiredForClosure',
        'latestPublishedRevisionNumber',
        'latestPublishedRevisionId',
        'latestPublishedContentHash',
        'updatedByUid',
        'updatedByName',
        'updatedAt',
        'version'
      ]);
    }

    function moduleRegistryFamilyPointerBootstrapChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'latestPublishedRevisionId',
        'latestPublishedContentHash',
        'updatedByUid',
        'updatedByName',
        'updatedAt',
        'version'
      ]);
    }

    function moduleRegistryFamilyRetireChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'retiredByUid',
        'retiredByName',
        'retiredAt',
        'retireReason',
        'updatedByUid',
        'updatedByName',
        'updatedAt',
        'version'
      ]);
    }


    function moduleRegistryHistoricalRevisionMatchesPointer(
      registryModuleId,
      revisionId,
      publishedHash,
      revisionNumber
    ) {
      let historicalRevision = getAfter(
        /databases/$(database)/documents/module_registry/$(registryModuleId)/revisions/$(revisionId)
      ).data;
      return historicalRevision.get('revisionId', null) == revisionId
        && historicalRevision.get('registryModuleId', null) == registryModuleId
        && (
          historicalRevision.get('revisionStatus', null) == 'published'
          || historicalRevision.get('revisionStatus', null) == 'retired'
        )
        && historicalRevision.get('revisionNumber', -1) == revisionNumber
        && historicalRevision.get('contentHash', null) == publishedHash;
    }

    function moduleRegistryPointerBootstrapMatchesHistory(registryModuleId) {
      let revisionId = request.resource.data.get('latestPublishedRevisionId', '');
      let publishedHash = request.resource.data.get('latestPublishedContentHash', '');
      return revisionId is string
        && revisionId.size() > 0
        && publishedHash is string
        && publishedHash.matches('^mrg1-sha256:[0-9a-f]{64}$')
        ? moduleRegistryHistoricalRevisionMatchesPointer(
            registryModuleId,
            revisionId,
            publishedHash,
            resource.data.get('latestPublishedRevisionNumber', -1)
          )
        : false;
    }

    function moduleRegistryRevisionMatchesPublishPointer(
      registryModuleId,
      revisionId,
      publishedHash
    ) {
      let publishedRevision = getAfter(
        /databases/$(database)/documents/module_registry/$(registryModuleId)/revisions/$(revisionId)
      ).data;
      return publishedRevision.get('revisionId', null) == revisionId
        && publishedRevision.get('registryModuleId', null) == registryModuleId
        && publishedRevision.get('revisionStatus', null) == 'published'
        && publishedRevision.get('revisionNumber', -1) ==
          request.resource.data.get('latestPublishedRevisionNumber', -1)
        && publishedRevision.get('contentHash', null) == publishedHash;
    }

    function moduleRegistryPublishPointerMatchesRevision(registryModuleId) {
      let revisionId = request.resource.data.get('latestPublishedRevisionId', '');
      let publishedHash = request.resource.data.get('latestPublishedContentHash', '');
      return revisionId is string
        && revisionId.size() > 0
        && publishedHash is string
        && publishedHash.matches('^mrg1-sha256:[0-9a-f]{64}$')
        ? moduleRegistryRevisionMatchesPublishPointer(
            registryModuleId,
            revisionId,
            publishedHash
          )
        : false;
    }

    // Legacy families may already have a published revision number while the
    // revision ID/hash pointers are absent. Keep this migration path narrow so
    // it does not consume the expression budget of the full publish validator.
    function validModuleRegistryFamilyPointerBootstrapUpdate(docId) {
      return isModuleRegistryGovernor()
        && resource.data.get('registryModuleId', null) == docId
        && request.resource.data.get('registryModuleId', null) == docId
        && moduleRegistryFamilyIdentityUnchanged()
        && resource.data.get('status', null) == 'active'
        && request.resource.data.get('status', null) == 'active'
        && moduleRegistryFamilyPointerBootstrapChangedFieldsOnly()
        && resource.data.get('latestPublishedRevisionNumber', -1) is int
        && resource.data.get('latestPublishedRevisionNumber', -1) > 0
        && request.resource.data.get('latestPublishedRevisionNumber', -1) ==
          resource.data.get('latestPublishedRevisionNumber', -1)
        && (
          resource.data.get('latestPublishedRevisionId', null) == null
          || resource.data.get('latestPublishedRevisionId', null) ==
            request.resource.data.get('latestPublishedRevisionId', null)
        )
        && (
          resource.data.get('latestPublishedContentHash', null) == null
          || resource.data.get('latestPublishedContentHash', null) ==
            request.resource.data.get('latestPublishedContentHash', null)
        )
        && (
          resource.data.get('latestPublishedRevisionId', null) == null
          || resource.data.get('latestPublishedContentHash', null) == null
        )
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) ==
          resource.data.get('version', -1) + 1
        && moduleRegistryPointerBootstrapMatchesHistory(docId);
    }

    function validModuleRegistryFamilyPublishDelta(docId) {
      return resource.data.get('status', null) == 'active'
        && request.resource.data.get('status', null) == 'active'
        && moduleRegistryFamilyPublishChangedFieldsOnly()
        && request.resource.data.get('latestPublishedRevisionNumber', null) ==
          resource.data.get('latestPublishedRevisionNumber', null) + 1
        && moduleRegistryPublishPointerMatchesRevision(docId)
        && (
          resource.data.get('latestPublishedRevisionNumber', 0) == 0
          || (
            resource.data.get('latestPublishedRevisionId', null) is string
            && resource.data.get('latestPublishedRevisionId', '').size() > 0
            && resource.data.get('latestPublishedContentHash', null) is string
            && resource.data.get('latestPublishedContentHash', '')
              .matches('^mrg1-sha256:[0-9a-f]{64}$')
            && request.resource.data.get(
                  'latestPublishedContentHash',
                  null
                ) !=
              resource.data.get('latestPublishedContentHash', null)
          )
        );
    }

    function validModuleRegistryFamilyRetireDelta() {
      return resource.data.get('status', null) == 'active'
        && request.resource.data.get('status', null) == 'retired'
        && moduleRegistryFamilyRetireChangedFieldsOnly()
        && request.resource.data.get('latestPublishedRevisionNumber', null) ==
          resource.data.get('latestPublishedRevisionNumber', null)
        && request.resource.data.get('retiredByUid', null) == request.auth.uid
        && request.resource.data.get('retiredAt', null) != null
        && request.resource.data.get('retireReason', null) is string;
    }

    function validModuleRegistryFamilyGovernedUpdate(docId) {
      return isModuleRegistryGovernor()
        && resource.data.get('registryModuleId', null) == docId
        && validModuleRegistryFamilyFields()
        && request.resource.data.get('registryModuleId', null) == docId
        && moduleRegistryFamilyIdentityUnchanged()
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) ==
          resource.data.get('version', -1) + 1
        && (request.resource.data.get('status', null) == 'active'
          ? validModuleRegistryFamilyPublishDelta(docId)
          : (request.resource.data.get('status', null) == 'retired'
            ? validModuleRegistryFamilyRetireDelta()
            : false));
    }

    function validModuleRegistryFamilyUpdate(docId) {
      return moduleRegistryFamilyPointerBootstrapChangedFieldsOnly()
        ? validModuleRegistryFamilyPointerBootstrapUpdate(docId)
        : validModuleRegistryFamilyGovernedUpdate(docId);
    }
    function validModuleRegistryRevisionFields() {
      return request.resource.data.keys().hasAll([
          'registryModuleId',
          'revisionId',
          'revisionNumber',
          'revisionStatus',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'checklistJson',
          'contentHash',
          'lineageJson',
          'createdByUid',
          'updatedByUid',
          'version',
          'schemaVersion',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'registryModuleId',
          'revisionId',
          'revisionNumber',
          'revisionStatus',
          'moduleSnapshotJson',
          'fieldDefinitionsJson',
          'checklistJson',
          'contentHash',
          'lineageJson',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedByUid',
          'updatedByName',
          'updatedAt',
          'publishedByUid',
          'publishedByName',
          'publishedAt',
          'retiredByUid',
          'retiredByName',
          'retiredAt',
          'retireReason',
          'version',
          'schemaVersion',
          'isDeleted'
        ])
        && request.resource.data.get('registryModuleId', null) is string
        && request.resource.data.get('revisionId', null) is string
        && request.resource.data.get('revisionNumber', -1) is int
        && request.resource.data.get('revisionNumber', -1) >= 0
        && isModuleRegistryRevisionStatus(request.resource.data.get('revisionStatus', null))
        && request.resource.data.get('moduleSnapshotJson', null) is string
        && request.resource.data.get('fieldDefinitionsJson', null) is string
        && request.resource.data.get('checklistJson', null) is string
        && request.resource.data.get('lineageJson', null) is string
        && moduleRegistryContentHashLooksValid()
        && request.resource.data.get('createdByUid', null) is string
        && moduleRegistryOptionalString(request.resource.data.get('createdByName', null))
        && request.resource.data.get('updatedByUid', null) is string
        && moduleRegistryOptionalString(request.resource.data.get('updatedByName', null))
        && moduleRegistryOptionalString(request.resource.data.get('publishedByUid', null))
        && moduleRegistryOptionalString(request.resource.data.get('publishedByName', null))
        && moduleRegistryOptionalString(request.resource.data.get('retiredByUid', null))
        && moduleRegistryOptionalString(request.resource.data.get('retiredByName', null))
        && moduleRegistryOptionalString(request.resource.data.get('retireReason', null))
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('schemaVersion', -1) == 1
        && request.resource.data.get('isDeleted', null) == false
        && validModuleRegistryRevisionTimeline();
    }

    function validModuleRegistryRevisionCreate(registryModuleId, revisionId) {
      return isModuleRegistryGovernor()
        && validModuleRegistryRevisionFields()
        && request.resource.data.get('registryModuleId', null) == registryModuleId
        && request.resource.data.get('revisionId', null) == revisionId
        && request.resource.data.get('revisionStatus', null) == 'draft'
        && request.resource.data.get('revisionNumber', -1) == 0
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('updatedByUid', null) == request.auth.uid;
    }

    function moduleRegistryRevisionIdentityUnchanged() {
      return request.resource.data.get('registryModuleId', null) == resource.data.get('registryModuleId', null)
        && request.resource.data.get('revisionId', null) == resource.data.get('revisionId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdByName', null) == resource.data.get('createdByName', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('schemaVersion', -1) == resource.data.get('schemaVersion', -1)
        && request.resource.data.get('isDeleted', null) == resource.data.get('isDeleted', null);
    }

    function moduleRegistryRevisionContentUnchanged() {
      return request.resource.data.get('moduleSnapshotJson', null) == resource.data.get('moduleSnapshotJson', null)
        && request.resource.data.get('fieldDefinitionsJson', null) == resource.data.get('fieldDefinitionsJson', null)
        && request.resource.data.get('checklistJson', null) == resource.data.get('checklistJson', null)
        && request.resource.data.get('contentHash', null) == resource.data.get('contentHash', null)
        && request.resource.data.get('lineageJson', null) == resource.data.get('lineageJson', null);
    }

    function moduleRegistryRevisionPublishMatchesFamily(
      registryModuleId,
      revisionId
    ) {
      let family = getAfter(
        /databases/$(database)/documents/module_registry/$(registryModuleId)
      ).data;
      return family.get('latestPublishedRevisionId', null) == revisionId
        && family.get('latestPublishedRevisionNumber', -1) ==
          request.resource.data.get('revisionNumber', -1)
        && family.get('latestPublishedContentHash', null) ==
          request.resource.data.get('contentHash', null);
    }

    function validModuleRegistryRevisionDraftEditDelta() {
      return resource.data.get('revisionStatus', null) == 'draft'
        && request.resource.data.get('revisionStatus', null) == 'draft'
        && request.resource.data.get('revisionNumber', -1) ==
          resource.data.get('revisionNumber', -1);
    }

    function validModuleRegistryRevisionPublishDelta(
      registryModuleId,
      revisionId
    ) {
      return resource.data.get('revisionStatus', null) == 'draft'
        && request.resource.data.get('revisionStatus', null) == 'published'
        && moduleRegistryRevisionContentUnchanged()
        && request.resource.data.get('revisionNumber', -1) is int
        && request.resource.data.get('revisionNumber', -1) > 0
        && moduleRegistryRevisionPublishMatchesFamily(
          registryModuleId,
          revisionId
        )
        && request.resource.data.get('publishedByUid', null) == request.auth.uid
        && request.resource.data.get('publishedAt', null) != null;
    }

    function validModuleRegistryRevisionRetireDelta() {
      return resource.data.get('revisionStatus', null) == 'published'
        && request.resource.data.get('revisionStatus', null) == 'retired'
        && moduleRegistryRevisionContentUnchanged()
        && request.resource.data.get('revisionNumber', -1) ==
          resource.data.get('revisionNumber', -1)
        && request.resource.data.get('retiredByUid', null) == request.auth.uid
        && request.resource.data.get('retiredAt', null) != null
        && request.resource.data.get('retireReason', null) is string;
    }

    function validModuleRegistryRevisionUpdateDelta(
      registryModuleId,
      revisionId
    ) {
      let sourceStatus = resource.data.get('revisionStatus', null);
      let targetStatus = request.resource.data.get('revisionStatus', null);
      return sourceStatus == 'draft'
        ? (targetStatus == 'draft'
          ? validModuleRegistryRevisionDraftEditDelta()
          : (targetStatus == 'published'
            ? validModuleRegistryRevisionPublishDelta(
                registryModuleId,
                revisionId
              )
            : false))
        : (sourceStatus == 'published' && targetStatus == 'retired'
          ? validModuleRegistryRevisionRetireDelta()
          : false);
    }

    function validModuleRegistryRevisionUpdate(registryModuleId, revisionId) {
      return isModuleRegistryGovernor()
        && validModuleRegistryRevisionFields()
        && resource.data.get('registryModuleId', null) == registryModuleId
        && resource.data.get('revisionId', null) == revisionId
        && request.resource.data.get('registryModuleId', null) == registryModuleId
        && request.resource.data.get('revisionId', null) == revisionId
        && moduleRegistryRevisionIdentityUnchanged()
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) ==
          resource.data.get('version', -1) + 1
        && validModuleRegistryRevisionUpdateDelta(
          registryModuleId,
          revisionId
        );
    }

    function validModuleRegistryAuditCreate(docId) {
      return isModuleRegistryGovernor()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'registryModuleId',
          'action',
          'performedByUid',
          'performedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'firestoreId',
          'registryModuleId',
          'revisionId',
          'revisionNumber',
          'action',
          'performedByUid',
          'performedByName',
          'performedAt',
          'reasonNotes',
          'beforeHash',
          'afterHash',
          'lineageSummaryJson',
          'version',
          'isDeleted'
        ])
        && request.resource.data.get('firestoreId', null) == docId
        && request.resource.data.get('registryModuleId', null) is string
        && isModuleRegistryAuditAction(request.resource.data.get('action', null))
        && request.resource.data.get('performedByUid', null) == request.auth.uid
        && moduleRegistryOptionalString(request.resource.data.get('revisionId', null))
        && (
          request.resource.data.get('revisionNumber', null) == null
          || request.resource.data.get('revisionNumber', null) is int
        )
        && moduleRegistryOptionalString(request.resource.data.get('performedByName', null))
        && isPersistedTimestamp(
          request.resource.data.get('performedAt', null)
        )
        && moduleRegistryOptionalString(request.resource.data.get('reasonNotes', null))
        && moduleRegistryOptionalString(request.resource.data.get('beforeHash', null))
        && moduleRegistryOptionalString(request.resource.data.get('afterHash', null))
        && moduleRegistryOptionalString(request.resource.data.get('lineageSummaryJson', null))
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) >= 1
        && request.resource.data.get('isDeleted', null) == false;
    }

    // ─────────────────────────────────────────────
    // 🧠 BAF KNOWLEDGE BASE HELPERS
    // ─────────────────────────────────────────────

    function isKnowledgeReadiness(status) {
      return status == 'readyPreset'
        || status == 'needsReview'
        || status == 'consultRequired'
        || status == 'tagOnly'
        || status == 'troubleshootingOnly'
        || status == 'futureIntegration'
        || status == 'referenceOnly';
    }

    function isKnowledgeConfidence(status) {
      return status == 'confirmedManual'
        || status == 'confirmedUserRatified'
        || status == 'inferred'
        || status == 'inferredNeedsReview'
        || status == 'plantInactiveFuturePreset'
        || status == 'consultUser'
        || status == 'confirmed';
    }

    function isKnowledgeLifecycleStatus(status) {
      return status == 'active'
        || status == 'retired'
        || status == 'archived';
    }

    function validKnowledgeChangeSummary() {
      return request.resource.data.get('changeSummary', null) is string
        && request.resource.data.get('changeSummary', null).size() >= 15;
    }

    function validKnowledgeBaseCommon(docId) {
      return isTemplateGovernor()
        && request.resource.data.get('rowCode', null) == docId
        && request.resource.data.get('schemaVersion', -1) == 1
        && request.resource.data.get('taskText', null) is string
        && request.resource.data.get('moduleCandidateCode', null) is string
        && request.resource.data.get('ownerDisciplines', []) is list
        && request.resource.data.get('safetyClasses', []) is list
        && request.resource.data.get('procedureRefs', []) is list
        && request.resource.data.get('partRefs', []) is list
        && request.resource.data.get('deviceTags', []) is list
        && request.resource.data.get('targetRefs', []) is list
        && request.resource.data.get('suggestedFields', []) is list
        && request.resource.data.get('composerReadiness', null) is string
        && isKnowledgeReadiness(request.resource.data.get('composerReadiness', null))
        && request.resource.data.get('confidence', null) is string
        && isKnowledgeConfidence(request.resource.data.get('confidence', null))
        && request.resource.data.get('lifecycleStatus', null) is string
        && isKnowledgeLifecycleStatus(request.resource.data.get('lifecycleStatus', null))
        && request.resource.data.get('matrixVersion', null) is string
        && validKnowledgeChangeSummary()
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time;
    }

    function validKnowledgeBaseCreate(docId) {
      return validKnowledgeBaseCommon(docId)
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) == 1
        && request.resource.data.get('createdByUid', null) == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('isDeleted', null) == false;
    }

    function validKnowledgeBaseUpdate(docId) {
      return validKnowledgeBaseCommon(docId)
        && resource.data.get('rowCode', null) == docId
        && request.resource.data.get('rowCode', null) == resource.data.get('rowCode', null)
        && request.resource.data.get('schemaVersion', -1) == resource.data.get('schemaVersion', -1)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('version', -1) is int
        && resource.data.get('version', -1) is int
        && request.resource.data.get('version', -1) > resource.data.get('version', -1)
        && request.resource.data.get('changeSummary', null) != resource.data.get('changeSummary', '')
        && request.resource.data.get('isDeleted', null) == resource.data.get('isDeleted', false);
    }

    function validKnowledgeMetaWrite(docId) {
      return isTemplateGovernor()
        && docId == 'current'
        && request.resource.data.get('matrixVersion', null) is string
        && request.resource.data.get('sourceLabel', null) is string
        && request.resource.data.get('knowledgeRowCount', -1) is int
        && request.resource.data.get('tagRowCount', -1) is int
        && request.resource.data.get('schemaVersion', -1) == 1
        && request.resource.data.get('version', -1) is int
        && request.resource.data.get('updatedByUid', null) == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('changeSummary', null) is string
        && request.resource.data.get('changeSummary', null).size() >= 15;
    }

