    function validTemplateVersionCreate(docId) {
      return isTemplateGovernor()
        && request.resource.data.firestoreId == docId
        && request.resource.data.packageFirestoreId is string
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber >= 1
        && request.resource.data.status == 'draft'
        && request.resource.data.jobTemplateSnapshotJson is string
        && request.resource.data.moduleSnapshotsJson is string
        && request.resource.data.fieldDefinitionsJson is string
        && request.resource.data.checklistJson is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.schemaVersion is int
        && request.resource.data.isDeleted == false;
