    function templateVersionPayloadJsonUnchanged() {
      return request.resource.data.jobTemplateSnapshotJson == resource.data.jobTemplateSnapshotJson
        && request.resource.data.moduleSnapshotsJson == resource.data.moduleSnapshotsJson
        && request.resource.data.fieldDefinitionsJson == resource.data.fieldDefinitionsJson
        && request.resource.data.checklistJson == resource.data.checklistJson
