        && request.resource.data.get('deviceTagRefs', []) == resource.data.get('deviceTagRefs', [])
        && request.resource.data.get('safetyClass', null) == resource.data.get('safetyClass', null)
        && request.resource.data.get('safetyGatePolicyJson', null) == resource.data.get('safetyGatePolicyJson', null)
        && request.resource.data.get('procedureRefs', []) == resource.data.get('procedureRefs', [])
        && request.resource.data.get('operationalStatePreconditions', []) == resource.data.get('operationalStatePreconditions', []);
    }

    function templateVersionFrozenPayloadUnchanged() {
      return templateVersionPayloadJsonUnchanged()
        && request.resource.data.get('contentHash', null) == resource.data.get('contentHash', null)
        && request.resource.data.get('closureReviewConfirmed', false) == resource.data.get('closureReviewConfirmed', false)
        && request.resource.data.get('closureReviewConfirmedByUid', null) == resource.data.get('closureReviewConfirmedByUid', null)
        && request.resource.data.get('closureReviewConfirmedByName', null) == resource.data.get('closureReviewConfirmedByName', null)
        && request.resource.data.get('closureReviewConfirmedAt', null) == resource.data.get('closureReviewConfirmedAt', null)
        && request.resource.data.get('closureCriticalModuleCount', 0) == resource.data.get('closureCriticalModuleCount', 0);
    }

    function templateContentHashLooksValid() {
      return request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^tg2-sha256:[0-9a-f]{64}$');
    }

    function closureReviewPolicySatisfied() {
      return request.resource.data.get('closureCriticalModuleCount', 0) is int
        && (
          request.resource.data.get('closureCriticalModuleCount', 0) == 0
          || (
            request.resource.data.get('closureReviewConfirmed', false) == true
            && request.resource.data.get('closureReviewConfirmedByUid', '') == request.auth.uid
            && request.resource.data.get('closureReviewConfirmedAt', null) != null
          )
        );
