        && request.resource.data.targetRefs is list
        && request.resource.data.suggestedFields is list
        && request.resource.data.composerReadiness is string
        && isKnowledgeReadiness(request.resource.data.composerReadiness)
        && request.resource.data.confidence is string
        && isKnowledgeConfidence(request.resource.data.confidence)
        && request.resource.data.lifecycleStatus is string
        && isKnowledgeLifecycleStatus(request.resource.data.lifecycleStatus)
        && request.resource.data.matrixVersion is string
        && validKnowledgeChangeSummary()
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validKnowledgeBaseCreate(docId) {
      return validKnowledgeBaseCommon(docId)
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.isDeleted == false;
    }

    function validKnowledgeBaseUpdate(docId) {
      return validKnowledgeBaseCommon(docId)
        && resource.data.rowCode == docId
        && request.resource.data.rowCode == resource.data.rowCode
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version
        && request.resource.data.changeSummary != resource.data.get('changeSummary', '')
        && request.resource.data.isDeleted == resource.data.get('isDeleted', false);
    }

    function validKnowledgeMetaWrite(docId) {
      return isTemplateGovernor()
        && docId == 'current'
        && request.resource.data.matrixVersion is string
        && request.resource.data.sourceLabel is string
        && request.resource.data.knowledgeRowCount is int
        && request.resource.data.tagRowCount is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.version is int
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.changeSummary is string
        && request.resource.data.changeSummary.size() >= 15;
    }

    // ─────────────────────────────────────────────
    // 🔧 MAINTENANCE HELPERS
    // ─────────────────────────────────────────────

    function validMaintenanceCreate(docId) {
      return isApprovedUser()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'version',
          'assetType',
          'assetNumber',
          'maintenanceType',
          'description',
          'routedTo',
          'status',
          'isResolved',
          'isCritical',
          'loggedByUid',
          'createdAt',
          'updatedAt',
          'isDeleted'
        ])
        && request.resource.data.firestoreId == docId
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.assetType is string
        && request.resource.data.assetNumber is int
        && request.resource.data.maintenanceType is string
        && request.resource.data.description is string
        && request.resource.data.routedTo is string
        && request.resource.data.status is string
        && request.resource.data.isResolved == false
        && request.resource.data.isCritical is bool
        && request.resource.data.loggedByUid == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.isDeleted == false;
    }

    function maintenanceCloseChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isResolved',
        'status',
        'closedByUid',
        'closedByName',
        'closedAt',
        'resolvedByUid',
        'resolvedByName',
        'resolvedAt',
        'resolutionNote',
        'resolutionNotes',
        'resolutionDetails',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ]);
    }

    function maintenanceResolutionFieldsFrozenOnReopen() {
      return request.resource.data.get('closedByUid', null) == resource.data.get('closedByUid', null)
        && request.resource.data.get('closedByName', null) == resource.data.get('closedByName', null)
        && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
        && request.resource.data.get('resolvedByUid', null) == resource.data.get('resolvedByUid', null)
        && request.resource.data.get('resolvedByName', null) == resource.data.get('resolvedByName', null)
        && request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null)
        && request.resource.data.get('resolutionNote', null) == resource.data.get('resolutionNote', null)
        && request.resource.data.get('resolutionNotes', null) == resource.data.get('resolutionNotes', null)
        && request.resource.data.get('resolutionDetails', null) == resource.data.get('resolutionDetails', null);
    }

    function maintenanceReopenChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isResolved',
        'status',
        'reopenedByUid',
        'reopenedByName',
        'reopenedAt',
        'reopenReason',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ])
      && maintenanceResolutionFieldsFrozenOnReopen();
    }

    function maintenanceVersionAdvances() {
      return request.resource.data.version is int
        && resource.data.version is int
        && request.resource.data.version > resource.data.version;
    }

    function validMaintenanceClose() {
      return canCloseMaintenanceTicket()
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == false
        && resource.data.get('isResolved', false) == false
        && request.resource.data.get('isResolved', false) == true
        && request.resource.data.closedByUid == request.auth.uid
        && maintenanceVersionAdvances()
        && maintenanceCloseChangedFieldsOnly();
    }

    function validMaintenanceReopen() {
      return canReopenMaintenanceTicket()
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == false
        && resource.data.get('isResolved', false) == true
        && request.resource.data.get('isResolved', false) == false
        && maintenanceVersionAdvances()
        && maintenanceReopenChangedFieldsOnly();
    }

    function maintenanceAdminEditChangedFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'maintenanceType',
        'description',
        'routedTo',
        'status',
        'isResolved',
        'isCritical',
        'component',
        'subsystem',
        'tag',
        'classification',
        'otherDepartment',
        'remarks',
        'endDate',
        'closedByUid',
        'closedByName',
        'downtimeHours',
        'teamsInvolved',
        'actionsJson',
        'resolutionHistoryJson',
        'updatedAt',
        'updatedByUid',
        'updatedByName',
        'version'
      ]);
    }

    function validMaintenanceAdminEdit() {
      return isAdmin()
        && request.resource.data.firestoreId == resource.data.firestoreId
        && request.resource.data.assetType == resource.data.assetType
        && request.resource.data.assetNumber == resource.data.assetNumber
        && request.resource.data.loggedByUid == resource.data.loggedByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
        && maintenanceVersionAdvances()
        && maintenanceAdminEditChangedFieldsOnly();
    }

    function validMaintenanceAdminSoftDelete() {
      return isAdmin()
        && resource.data.get('isDeleted', false) == false
        && request.resource.data.get('isDeleted', false) == true
        && request.resource.data.firestoreId == resource.data.firestoreId
        && request.resource.data.assetType == resource.data.assetType
        && request.resource.data.assetNumber == resource.data.assetNumber
        && request.resource.data.loggedByUid == resource.data.loggedByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deletedByUid == request.auth.uid
        && maintenanceVersionAdvances()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'deletedAt',
          'deletedByUid',
          'deletedByName',
          'deleteReason',
          'updatedAt',
          'version'
        ]);
    }

    // ─────────────────────────────────────────────
    // ⚠️ ABNORMALITY HELPERS
    // ─────────────────────────────────────────────

    function validChargeAbnormalityCreate(docId) {
      return canLogChargeAbnormality()
        && request.resource.data.keys().hasAll([
          'firestoreId',
          'sourceChargeNo',
          'abnormalityTypeId',
          'abnormalityTypeTitle',
          'abnormalityTypeCode',
          'category',
          'severity',
          'affectedAssets',
          'observedReason',
          'loggedAt',
          'updatedAt',
          'loggedByUid',
          'updatedByUid',
          'version',
          'isDeleted'
        ])
        && request.resource.data.firestoreId == docId
        && request.resource.data.sourceChargeNo is int
        && request.resource.data.abnormalityTypeId is string
        && request.resource.data.abnormalityTypeTitle is string
        && request.resource.data.abnormalityTypeCode is string
        && request.resource.data.category is string
        && request.resource.data.severity is string
        && request.resource.data.affectedAssets is list
        && request.resource.data.observedReason is string
        && request.resource.data.loggedAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.loggedByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.isDeleted == false;
    }

    // ─────────────────────────────────────────────
    // 🛡️ AUDIT HELPERS
    // ─────────────────────────────────────────────

    function validNonEmptyString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null
        || (
          value is string
          && value.size() <= maxLength
        );
    }

    function validAuditActionValue(action) {
      return action == 'create'
        || action == 'update'
        || action == 'resolve'
        || action == 'reopen'
        || action == 'delete'
        || action == 'seed_baseline';
    }

    function validAuditSeverityValue(severity) {
      return severity == 'low'
        || severity == 'medium'
        || severity == 'high';
    }

    function validStandardAuditCreate() {
      return request.resource.data.keys().hasAll([
          'entityType',
          'entityId',
          'action',
          'performedByUid',
          'timestamp',
          'severity'
        ])
        && request.resource.data.keys().hasOnly([
          'entityType',
          'entityId',
          'action',
          'performedByUid',
          'performedByName',
          'timestamp',
          'reason',
          'reasonNotes',
          'summary',
          'severity',
          'beforeJson',
          'afterJson'
        ])
        && validNonEmptyString(request.resource.data.entityType, 80)
        && validNonEmptyString(request.resource.data.entityId, 200)
        && validAuditActionValue(request.resource.data.action)
        && request.resource.data.performedByUid == request.auth.uid
        && validOptionalString(request.resource.data.get('performedByName', null), 160)
        && request.resource.data.timestamp is timestamp
        && validAuditSeverityValue(request.resource.data.severity)
        && validOptionalString(request.resource.data.get('reason', null), 80)
        && validOptionalString(request.resource.data.get('reasonNotes', null), 2000)
        && validOptionalString(request.resource.data.get('summary', null), 500)
        && validOptionalString(request.resource.data.get('beforeJson', null), 20000)
        && validOptionalString(request.resource.data.get('afterJson', null), 20000);
    }

    function validKnowledgeSeedAuditCreate() {
      return request.resource.data.keys().hasAll([
          'type',
          'action',
          'performedByUid',
          'performedAt',
          'version',
          'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'action',
          'performedByUid',
          'performedByName',
          'performedAt',
          'details',
          'matrixVersion',
          'rowCount',
          'version',
          'isDeleted'
        ])
        && request.resource.data.type == 'knowledge_base_seed'
        && request.resource.data.action == 'seed_baseline'
        && request.resource.data.performedByUid == request.auth.uid
        && validOptionalString(request.resource.data.get('performedByName', null), 160)
        && request.resource.data.performedAt is timestamp
        && validOptionalString(request.resource.data.get('details', null), 2000)
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.isDeleted == false;
    }

    function validAuditCreate() {
      return isApprovedUser()
        && (
          validStandardAuditCreate()
          || validKnowledgeSeedAuditCreate()
        );
    }

    // ─────────────────────────────────────────────
    // 👤 USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if validPendingUserCreate(userId)
        || validAdminUserWrite(userId);

      allow update: if validSelfUserUpdate(userId)
        || validAdminUserWrite(userId);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧠 BAF KNOWLEDGE BASE
    // ─────────────────────────────────────────────

    match /knowledge_base/{docId} {
      allow read: if isApprovedUser();
      allow create: if validKnowledgeBaseCreate(docId);
      allow update: if validKnowledgeBaseUpdate(docId);
      allow delete: if false;
    }

    match /knowledge_base_meta/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if validKnowledgeMetaWrite(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🔧 MAINTENANCE RECORDS
    // ─────────────────────────────────────────────

    match /maintenance_records/{docId} {
      allow read: if isApprovedUser();
      allow create: if validMaintenanceCreate(docId);
      allow update: if validMaintenanceAdminEdit()
        || validMaintenanceAdminSoftDelete()
        || validMaintenanceClose()
        || validMaintenanceReopen();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧬 TEMPLATE GOVERNANCE
    // ─────────────────────────────────────────────

    match /template_packages/{docId} {
      allow read: if isApprovedUser();
      allow create: if validTemplatePackageCreate(docId);
      allow update: if validTemplatePackageUpdate(docId);
      allow delete: if false;
    }

    match /template_versions/{docId} {
      allow read: if isApprovedUser();
      allow create: if validTemplateVersionCreate(docId);
      allow update: if validTemplateVersionUpdate(docId);
      allow delete: if false;
    }

    match /template_publish_audits/{docId} {
      allow read: if isAdmin();
      allow create: if validTemplatePublishAuditCreate(docId);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧩 GOVERNED MODULE REGISTRY
    // ─────────────────────────────────────────────

    match /module_registry/{registryModuleId} {
      allow read: if isApprovedUser();
      allow create: if validModuleRegistryFamilyCreate(registryModuleId);
      allow update: if validModuleRegistryFamilyUpdate(registryModuleId);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isApprovedUser();
        allow create: if validModuleRegistryRevisionCreate(registryModuleId, revisionId);
        allow update: if validModuleRegistryRevisionUpdate(registryModuleId, revisionId);
        allow delete: if false;
      }
    }


    match /module_registry_audits/{docId} {
      allow read: if isAdmin();
      allow create: if validModuleRegistryAuditCreate(docId);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧩 JOB TEMPLATES
    // ─────────────────────────────────────────────

    match /job_templates/{docId} {
      allow read: if isApprovedUser();
      allow create: if validLegacyJobTemplateCreate();
      allow update: if validLegacyJobTemplateUpdate();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // ⚙️ JOB EXECUTIONS
    // ─────────────────────────────────────────────

    match /job_executions/{docId} {
      allow read: if isApprovedUser();
      allow create: if validJobExecutionCreate(docId);
      allow update: if validJobExecutionUpdate(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 📝 JOB DIARY ENTRIES
    // ─────────────────────────────────────────────

    match /job_diary_entries/{docId} {
      allow read: if isApprovedUser();
      allow create: if validJobDiaryCreate(docId);
      allow update: if validJobDiaryUpdate(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧱 JOB MODULES
    // ─────────────────────────────────────────────

    match /job_modules/{docId} {
      allow read: if isApprovedUser();
      allow create: if validJobModuleCreate(docId);
      allow update: if validJobModuleUpdate(docId);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 📢 DIRECTIVES
    // ─────────────────────────────────────────────

    match /directives/{docId} {
      allow read: if isApprovedUser();
      allow create: if validDirectiveCreate(docId);
      allow update: if validDirectiveUpdate();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🔋 CHARGES
    // Base Charge is reserved for future IoT / Level-2 / plant integration.
    // Current app-owned operational sync scope is Charge Abnormality only.
    // ─────────────────────────────────────────────

    match /charges/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // ⚠️ ABNORMALITY TYPES
    // ─────────────────────────────────────────────

    match /abnormality_types/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🧾 CHARGE ABNORMALITIES
    // ─────────────────────────────────────────────

    match /charge_abnormalities/{docId} {
      allow read: if isApprovedUser();
      allow create: if validChargeAbnormalityCreate(docId);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🛡️ AUDIT LOGS
    // ─────────────────────────────────────────────

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // 🚫 DEFAULT DENY
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
